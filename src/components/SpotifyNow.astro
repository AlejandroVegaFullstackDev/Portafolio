---
// SpotifyNow.astro — fixed now-playing widget, driven by 'spotify:update' custom event
---

<div id="spWidget" aria-live="polite" aria-label="Now playing on Spotify">
  <span class="sp-c sp-tl"></span>
  <span class="sp-c sp-tr"></span>
  <span class="sp-c sp-bl"></span>
  <span class="sp-c sp-br"></span>

  <div class="sp-head">
    <span class="sp-label">// NOW_PLAYING</span>
    <div class="sp-eq" id="spEq">
      <span></span><span></span><span></span><span></span>
    </div>
  </div>

  <div class="sp-body">
    <div class="sp-art-wrap">
      <img id="spArt" src="" alt="" width="56" height="56" />
      <div class="sp-art-scan"></div>
    </div>
    <div class="sp-meta">
      <div id="spTitle" class="sp-title">—</div>
      <div id="spArtist" class="sp-artist">—</div>
      <div class="sp-prog-row">
        <div class="sp-prog-track">
          <div id="spBar" class="sp-prog-fill"></div>
        </div>
        <span id="spTime" class="sp-time">0:00</span>
      </div>
      <a id="spLink" href="#" target="_blank" rel="noopener noreferrer" class="sp-link">
        ↗ SPOTIFY
      </a>
    </div>
  </div>
</div>

<style>
#spWidget {
  position: fixed;
  bottom: 24px;
  left: 24px;
  z-index: 200;
  width: 268px;
  background: var(--panel);
  border: 1px solid var(--line);
  display: none;
  flex-direction: column;
  overflow: hidden;
  will-change: transform, opacity;
}

.sp-c {
  position: absolute;
  width: 10px;
  height: 10px;
  border-color: var(--accent);
  border-style: solid;
  pointer-events: none;
}
.sp-tl { top: -1px; left: -1px; border-width: 1px 0 0 1px; }
.sp-tr { top: -1px; right: -1px; border-width: 1px 1px 0 0; }
.sp-bl { bottom: -1px; left: -1px; border-width: 0 0 1px 1px; }
.sp-br { bottom: -1px; right: -1px; border-width: 0 1px 1px 0; }

.sp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 7px 12px;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 0, 60, 0.05);
}
.sp-label {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.16em;
  color: var(--accent);
}
.sp-eq {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 12px;
}
.sp-eq span {
  display: block;
  width: 3px;
  height: 4px;
  background: var(--accent);
  border-radius: 1px;
  transform-origin: bottom center;
}

.sp-body {
  display: flex;
  gap: 12px;
  padding: 12px;
  align-items: flex-start;
}

.sp-art-wrap {
  position: relative;
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  overflow: hidden;
  border: 1px solid var(--line);
  background: var(--bg-2);
}
.sp-art-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.sp-art-scan {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(0,0,0,0.18) 2px,
    rgba(0,0,0,0.18) 3px
  );
  pointer-events: none;
}

.sp-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.sp-title {
  font-family: var(--font-display);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 1.1em;
}
.sp-artist {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-height: 1em;
}

.sp-prog-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}
.sp-prog-track {
  flex: 1;
  height: 2px;
  background: var(--line);
  position: relative;
  overflow: hidden;
}
.sp-prog-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 0%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
}
.sp-time {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--ink-3);
  flex-shrink: 0;
  letter-spacing: 0.04em;
}
.sp-link {
  display: inline-block;
  margin-top: 4px;
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.12em;
  color: var(--ink-3);
  text-decoration: none;
  transition: color 0.2s;
}
.sp-link:hover { color: var(--accent); }

@media (max-width: 480px) {
  #spWidget { width: calc(100vw - 32px); bottom: 16px; left: 16px; }
}
/* Se aparta mientras el Snake está en pantalla (no tapa el juego). */
#spWidget.sp-away { opacity: 0 !important; pointer-events: none; transform: translateY(16px) !important; transition: opacity 0.25s, transform 0.25s; }
</style>

<script>
  import { initSpotifyWidget } from '../scripts/spotifyWidget';
  initSpotifyWidget();
</script>
