---
// Easter egg: terminal secreta. Se abre escribiendo "sudo" (desktop) o tocando
// 5 veces el logo. Lógica en scripts/fx/secretTerminal.ts.
import { portfolioData as D } from '../../data';
import { getSortedPosts } from '../../lib/blog';

const posts = await getSortedPosts();
const termData = {
  name: D.identity.name,
  title: D.identity.title,
  linkedin: D.identity.contact.linkedin,
  github: D.identity.contact.github,
  stack: [...D.stack.languages, ...D.stack.frameworks, ...D.stack.databases],
  projects: D.projects.map((p) => ({ n: p.n, slug: p.slug, name: p.name })),
  posts: posts.map((p) => ({ slug: p.slug, title: p.data.title })),
};
---
<div id="secretTerm" class="st" role="dialog" aria-modal="true" aria-label="Terminal" hidden>
  <div class="st-win">
    <div class="cy-term-bar">
      <span class="dot r"></span><span class="dot"></span><span class="dot"></span>
      <span>root@4ledmt:~#</span><span class="label">esc para salir</span>
    </div>
    <div class="st-out" id="stOut" aria-live="polite"></div>
    <form class="st-prompt" id="stForm" autocomplete="off">
      <label for="stIn" class="st-ps1">$</label>
      <input id="stIn" class="st-in" type="text" spellcheck="false" autocapitalize="off" enterkeyhint="send" />
    </form>
  </div>
</div>
<script type="application/json" id="termData" set:html={JSON.stringify(termData)} />

<style>
  .st { position: fixed; inset: 0; z-index: 10001; display: grid; place-items: center; padding: 1rem; background: color-mix(in srgb, #000 72%, transparent); }
  .st[hidden] { display: none; }
  .st-win { width: min(720px, 100%); height: min(70svh, 520px); display: flex; flex-direction: column; background: #000; border: 1px solid var(--accent); box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--accent) 50%, transparent); }
  .st-out { flex: 1; overflow-y: auto; padding: 14px 16px; font-family: var(--font-mono); font-size: 0.84rem; line-height: 1.6; color: #d4ffd4; }
  .st-out :global(.st-err) { color: var(--accent); }
  .st-out :global(.st-dim) { color: var(--ink-3); }
  .st-out :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .st-prompt { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-top: 1px solid var(--line); }
  .st-ps1 { color: var(--accent); font-family: var(--font-mono); }
  .st-in { flex: 1; background: transparent; border: 0; outline: none; color: var(--ink); font: 0.9rem var(--font-mono); caret-color: var(--accent); }
</style>
