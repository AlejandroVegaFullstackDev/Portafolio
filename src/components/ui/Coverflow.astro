---
// Carcasa del carrusel horizontal pinneado (motor en scripts/fx/coverflow.ts).
// La sección que lo usa pasa las diapositivas por <slot />.
// Estilos: src/styles/coverflow.css (globales: los comparten Proyectos y Blog).
interface Props {
  id: string;
  label: string;
  total: number;
  bgA: string;
  bgB: string;
}
const { id, label, total, bgA, bgB } = Astro.props;
---
<section id={id} class="hs border-y border-[var(--line)]" aria-label={label} data-coverflow>
  <div class="hs-viewport">
    <div class="hs-bg" aria-hidden="true">
      <div class="hs-bg-row hs-bg-row--a" data-hs-bg="a">{bgA} · {bgA} ·</div>
      <div class="hs-bg-row hs-bg-row--b" data-hs-bg="b">{bgB} · {bgB} ·</div>
      <div class="hs-speedlines"></div>
    </div>
    <div class="hs-track">
      <slot />
    </div>
    <div class="hs-hud" aria-hidden="true">
      <span class="hs-count"><span data-hs-index>01</span> / {String(total).padStart(2, '0')}</span>
      <span class="hs-bar"><span class="hs-bar-fill" data-hs-bar></span></span>
    </div>
    <slot name="overlay" />
  </div>
</section>
