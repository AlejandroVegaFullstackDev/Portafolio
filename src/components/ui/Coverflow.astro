---
// Carcasa del carrusel horizontal pinneado (motor en scripts/fx/coverflow.ts).
// La sección que lo usa pasa las diapositivas por <slot />.
// Estilos is:global porque el contenido del slot no recibe el scope de este archivo.
interface Props {
  id: string;
  label: string;
  total: number;
  bgA: string;
  bgB: string;
}
const { id, label, total, bgA, bgB } = Astro.props;
---
<section id={id} class="hs border-y border-[var(--line)]" aria-label={label} data-coverflow>
  <div class="hs-viewport">
    <div class="hs-bg" aria-hidden="true">
      <div class="hs-bg-row hs-bg-row--a" data-hs-bg="a">{bgA} · {bgA} ·</div>
      <div class="hs-bg-row hs-bg-row--b" data-hs-bg="b">{bgB} · {bgB} ·</div>
      <div class="hs-speedlines"></div>
    </div>
    <div class="hs-track">
      <slot />
    </div>
    <div class="hs-hud" aria-hidden="true">
      <span class="hs-count"><span data-hs-index>01</span> / {String(total).padStart(2, '0')}</span>
      <span class="hs-bar"><span class="hs-bar-fill" data-hs-bar></span></span>
    </div>
    <slot name="overlay" />
  </div>
</section>

<style is:global>
  /* Sin JS (o con movimiento reducido) es un carrusel con swipe nativo + scroll-snap.
     Con JS, GSAP pinea la sección y traduce el track: bajas → avanza a la derecha. */
  .hs { position: relative; background: var(--bg); }
  .hs-viewport {
    position: relative; height: 100svh; min-height: 560px;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    perspective: 1400px;
    perspective-origin: calc(var(--po-x, 50) * 1%) calc(var(--po-y, 50) * 1%);
    scrollbar-width: none;
  }
  .hs-viewport::-webkit-scrollbar { display: none; }
  .hs.is-pinned .hs-viewport { overflow: hidden; scroll-snap-type: none; }
  .hs-track {
    position: relative; z-index: 1;
    display: flex; align-items: center; gap: 4vw;
    height: 100%; width: max-content;
    padding: 64px 9vw 72px 0;
    transform-style: preserve-3d; will-change: transform;
  }
  .hs-slide {
    flex: 0 0 auto; scroll-snap-align: center;
    width: min(78vw, 1080px); height: min(70svh, 640px);
    transform-style: preserve-3d; color: inherit; text-decoration: none; display: block;
  }
  .hs-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; will-change: transform, opacity; }

  /* Intro (primera diapositiva, ocupa la pantalla) */
  .hs-intro { width: 100vw; height: 100%; }
  .hs-intro > .hs-inner {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center; gap: 2.5rem; padding: 0 5rem; max-width: 1480px; margin: 0 auto;
  }
  .hs-hint {
    margin-top: 2.5rem; display: inline-flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent);
  }
  .hs-hint-arrow { display: inline-block; animation: hsNudge 1.6s cubic-bezier(.16,1,.3,1) infinite; }
  @keyframes hsNudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(10px); } }

  /* Diapositiva de contenido */
  .hs-card > .hs-inner {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: linear-gradient(150deg, var(--panel), var(--bg-2));
    border: 1px solid var(--line-2); box-shadow: 0 40px 80px -40px rgba(0,0,0,0.8);
    overflow: hidden; transition: border-color 0.3s;
  }
  .hs-card:hover > .hs-inner, .hs-card:focus-visible > .hs-inner { border-color: var(--accent); }
  .hs-card:focus-visible { outline: none; }
  .hs-media { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; border-right: 1px solid var(--line); background: var(--bg-2); will-change: clip-path; }
  .hs-media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) contrast(1.05); transform: scale(1.12); will-change: transform; }
  .hs-bignum {
    font-family: var(--font-display); font-weight: 700; line-height: 0.8;
    font-size: clamp(8rem, 22vw, 18rem); letter-spacing: -0.06em;
    color: transparent; -webkit-text-stroke: 1px var(--accent); font-variant-numeric: tabular-nums;
  }
  .hs-copy { display: flex; flex-direction: column; justify-content: center; gap: 1.1rem; padding: clamp(1.5rem, 4vw, 3.5rem); min-width: 0; }
  .hs-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .hs-new { color: var(--accent); border: 1px solid var(--accent); padding: 1px 6px; letter-spacing: 0.14em; }
  .hs-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 4.2vw, 3.8rem); line-height: 0.98; letter-spacing: -0.035em; color: var(--ink); text-wrap: balance; }
  .hs-desc { color: var(--ink-2); font-size: 1.02rem; line-height: 1.6; max-width: 46ch; }
  .hs-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .hs-cta { margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }

  /* Diapositiva final */
  .hs-end { width: min(70vw, 900px); }
  .hs-end > .hs-inner { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 1.5rem; padding: 0 1rem; }
  .hs-end-kicker { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); }
  .hs-end-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(2.6rem, 7vw, 6rem); line-height: 0.92; letter-spacing: -0.04em; }

  /* Fondo vivo */
  .hs-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
  .hs-bg-row { position: absolute; left: 0; white-space: nowrap; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: transparent; will-change: transform; }
  .hs-bg-row--a { top: 8%; font-size: clamp(6rem, 18vw, 16rem); -webkit-text-stroke: 1px var(--line-2); }
  .hs-bg-row--b { bottom: 12%; font-size: clamp(3rem, 8vw, 7rem); -webkit-text-stroke: 1px color-mix(in srgb, var(--accent) 28%, transparent); }
  .hs-speedlines {
    position: absolute; inset: 0; opacity: 0;
    background: repeating-linear-gradient(0deg, transparent 0 22px, color-mix(in srgb, var(--accent) 16%, transparent) 22px 23px);
    -webkit-mask: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
            mask: linear-gradient(90deg, transparent, #000 20%, #000 80%, transparent);
  }

  /* HUD */
  .hs-hud {
    position: absolute; z-index: 1; left: 50%; bottom: 26px; transform: translateX(-50%);
    width: min(84vw, 520px); display: flex; align-items: center; gap: 14px;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--ink-3); font-variant-numeric: tabular-nums; pointer-events: none;
  }
  .hs-count { flex-shrink: 0; }
  .hs-count [data-hs-index] { color: var(--accent); }
  .hs-bar { flex: 1; height: 1px; background: var(--line-2); position: relative; overflow: hidden; }
  .hs-bar-fill { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left; }

  @media (max-width: 1023px) {
    .hs-track { padding: 56px 8vw 64px 0; }
    .hs-slide { width: 84vw; height: min(72svh, 620px); }
    .hs-intro { width: 100vw; height: 100%; }
    .hs-intro > .hs-inner { grid-template-columns: 1fr; padding: 0 1.5rem; gap: 1rem; align-content: center; }
    .hs-intro .section-title { font-size: clamp(2.4rem, 11vw, 4rem); }
    .hs-intro .hs-hint { margin-top: 1rem; }
    .hs-card > .hs-inner { grid-template-columns: 1fr; grid-template-rows: 38% 1fr; }
    .hs-media { border-right: 0; border-bottom: 1px solid var(--line); }
    .hs-copy { justify-content: flex-start; gap: 0.75rem; padding: 1.25rem; }
    .hs-desc { font-size: 0.92rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .hs-bignum { font-size: 7rem; }
    .hs-end { width: 84vw; }
  }
</style>
