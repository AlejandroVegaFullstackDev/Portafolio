---
// Barra superior de las páginas internas (proyecto, blog): volver + ruta + idioma.
interface Props { trail: string; back?: string }
const { trail, back = '/' } = Astro.props;
---
<header class="bar">
  <div class="flex items-center gap-4 min-w-0">
    <a href={back} class="back">← <span class="lang-es">PORTAFOLIO</span><span class="lang-en">PORTFOLIO</span></a>
    <span class="trail">{trail}</span>
  </div>
  <button id="langToggle" type="button" class="lang"><span class="lang-es">EN</span><span class="lang-en">ES</span></button>
</header>

<script>
  import { initLangToggle } from '../../scripts/core/i18n';
  initLangToggle();
</script>

<style>
  .bar {
    position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 14px clamp(1rem, 4vw, 2rem); border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px);
  }
  .back { font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.1em; white-space: nowrap; }
  .back:hover, .back:focus-visible { color: var(--accent); }
  .trail { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lang { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.1em; border: 1px solid var(--line-2); padding: 0.25rem 0.5rem; background: none; color: inherit; cursor: pointer; }
  .lang:hover, .lang:focus-visible { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 520px) { .trail { display: none; } }
</style>
