---
// Barra fija: logo (5 toques abren la terminal secreta), navegación, idioma,
// botón del menú móvil y ticker. El menú móvil vive en MobileMenu.astro.
interface Props { ticker: { icon: string; text: string }[] }
const { ticker } = Astro.props;
const nav = [
  { href: '#projects', label: 'projects' },
  { href: '#blog', label: 'blog' },
  { href: '#exp', label: 'experience' },
  { href: '/about', label: 'about' },
];
---
<header class="hdr" data-header>
  <div class="px-6 lg:px-10 h-12 flex items-center text-sm relative">
    <div class="flex items-center gap-4">
      <button type="button" id="logoBtn" class="logo" aria-label="Alejandro Vega">AV/_</button>
      <span class="font-mono text-[var(--ink-3)] tracking-widest text-[0.7rem] hidden sm:inline">4ledmt.dev</span>
    </div>
    <nav class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-5" aria-label="Principal">
      {nav.map((n) => <a href={n.href} class="nav-link" data-magnetic>{n.label}</a>)}
    </nav>
    <div class="flex items-center gap-3 ml-auto">
      <span class="cy-status hidden sm:inline-flex"><span class="lang-es">disponible</span><span class="lang-en">available</span></span>
      <button id="langToggle" type="button" class="hdr-btn"><span class="lang-es">EN</span><span class="lang-en">ES</span></button>
      <button id="mobileMenuBtn" type="button" class="hdr-btn md:hidden w-8 h-8" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">≡</button>
    </div>
  </div>
  <div class="ticker">
    <div class="cy-marquee" data-marquee="80">
      <div class="flex items-center">
        {ticker.map((t) => (
          <span class="ticker-item"><span class="text-[var(--accent)]">{t.icon}</span> {t.text}</span>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .hdr { position: fixed; top: 0; left: 0; right: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 70%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .logo { font-family: var(--font-mono); color: var(--accent); font-weight: 600; letter-spacing: 0.1em; background: none; border: 0; padding: 0; cursor: pointer; }
  .nav-link { display: inline-block; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em; color: var(--ink-3); transition: color 0.2s; }
  .nav-link:hover, .nav-link:focus-visible { color: var(--accent); }
  .hdr-btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.1em; color: var(--ink-3);
    border: 1px solid var(--line-2); padding: 0.25rem 0.5rem; background: none; cursor: pointer; transition: border-color 0.2s, color 0.2s;
  }
  .hdr-btn:hover, .hdr-btn:focus-visible { border-color: var(--accent); color: var(--accent); }
  .ticker { display: flex; align-items: center; height: 30px; border-top: 1px solid var(--line); overflow: hidden; background: var(--bg-2); max-width: 100vw; }
  .ticker-item { display: inline-flex; align-items: center; gap: 10px; padding: 0 18px; font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.1em; color: var(--ink-2); }
</style>
