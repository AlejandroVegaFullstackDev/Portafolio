---
// Pantalla de arranque tipo consola, solo en la primera visita de la sesión.
// La secuencia está en boot.client.ts (al lado).
// Oculta por defecto: sin JS (o con movimiento reducido) el contenido se ve de inmediato.
// El inline solo la muestra si va a correr, y la quita sola a los 4 s pase lo que pase.
---
<div id="boot" class="boot" aria-hidden="true">
  <div class="text-center font-mono text-[var(--ok)] text-sm leading-relaxed max-w-xl px-6">
    <div id="bootLog" class="text-left"></div>
  </div>
</div>
<script is:inline>
  (function () {
    try {
      if (sessionStorage.getItem('av_booted') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var r = document.documentElement;
      r.classList.add('js-boot');
      setTimeout(function () { r.classList.remove('js-boot'); }, 4000); // red de seguridad
    } catch (e) {}
  })();
</script>

<style>
  .boot {
    position: fixed; inset: 0; z-index: 10000; background: #000;
    display: none; align-items: center; justify-content: center; flex-direction: column;
    font-family: var(--font-mono); color: var(--ok);
  }
  :global(html.js-boot) .boot { display: flex; }
</style>
