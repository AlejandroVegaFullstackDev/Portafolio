---
// 06 · "Cómete mi playlist": Snake donde la comida son carátulas de mi playlist de Spotify.
// Una consola (barra de estado + tablero con sus estados) y un panel que gira en 3D entre
// "Sonando" y "Ranking". Lógica: scripts/game/snake.ts · estilos: styles/snake.css.
import { Pause, Play, RotateCcw, Trophy, Music2, Volume2, VolumeX } from 'lucide-static';
import SectionHeading from '../ui/SectionHeading.astro';
import '../../styles/snake.css';
---
<section id="snake" class="relative px-6 lg:px-20 py-20 lg:py-28 overflow-hidden" data-wipe>
  <div class="max-w-[1480px] mx-auto">
    <div class="sn-head">
      <SectionHeading num="06" label={{ es: 'RECESO', en: 'BREAK' }} es={{ pre: 'Cómete mi ', accent: 'playlist', post: '.' }} en={{ pre: 'Eat my ', accent: 'playlist', post: '.' }} />
      <p class="sn-lede">
        <span class="lang-es">Cada carátula es una canción de mi playlist.</span>
        <span class="lang-en">Every cover is a song from my playlist.</span>
      </p>
    </div>

    <div class="sn-arcade">
      <!-- Consola -->
      <div class="sn-console" data-snake-pad>
        <div class="sn-hud">
          <div class="sn-num"><span class="sn-k"><span class="lang-es">Puntos</span><span class="lang-en">Score</span></span><b data-snake-score>0</b></div>
          <div class="sn-num is-best"><span class="sn-k"><span class="lang-es">Récord</span><span class="lang-en">Best</span></span><b data-snake-best>0</b></div>
          <div class="sn-hud-btns">
            <button type="button" class="sn-icon sn-sound" data-snake-sound aria-pressed="false" title="Música" aria-label="Música">
              <span class="ic-on" set:html={Volume2} /><span class="ic-off" set:html={VolumeX} />
              <span class="sn-eq" aria-hidden="true"><i></i><i></i><i></i></span>
            </button>
            <button type="button" class="sn-icon" data-snake-pause title="Pausa" aria-label="Pausa" hidden><span set:html={Pause} /></button>
          </div>
        </div>

        <div class="board">
          <canvas data-snake-canvas tabindex="0" aria-label="Snake"></canvas>
          <div class="overlay" data-snake-overlay data-state="ready">
            <!-- Antes de jugar -->
            <div class="ov ov-ready">
              <p class="ov-title"><span class="lang-es">¿Listo?</span><span class="lang-en">Ready?</span></p>
              <div class="ov-actions">
                <button type="button" class="cy-btn solid with-music" data-play="music"><span set:html={Music2} /><span class="lang-es">Jugar con música</span><span class="lang-en">Play with music</span></button>
                <button type="button" class="cy-btn solid no-music" data-play="silent"><span set:html={Play} /><span class="lang-es">Jugar</span><span class="lang-en">Play</span></button>
                <button type="button" class="ov-link with-music" data-play="silent"><span class="lang-es">o sin sonido</span><span class="lang-en">or muted</span></button>
              </div>
              <p class="ov-hint"><span class="hint-desk">← ↑ → ↓ · WASD</span><span class="hint-touch"><span class="lang-es">Desliza para girar</span><span class="lang-en">Swipe to turn</span></span></p>
            </div>
            <!-- Pausa -->
            <div class="ov ov-paused">
              <p class="ov-title"><span class="lang-es">En pausa</span><span class="lang-en">Paused</span></p>
              <div class="ov-actions">
                <button type="button" class="cy-btn solid" data-resume><span set:html={Play} /><span class="lang-es">Seguir</span><span class="lang-en">Resume</span></button>
                <button type="button" class="ov-link" data-restart><span class="lang-es">Empezar de nuevo</span><span class="lang-en">Start over</span></button>
              </div>
            </div>
            <!-- Fin -->
            <div class="ov ov-over">
              <p class="ov-badge" data-over-badge hidden><span class="lang-es">¡Nuevo récord!</span><span class="lang-en">New best!</span></p>
              <p class="ov-title" data-over-title></p>
              <ul class="ov-strip" data-over-strip aria-hidden="true"></ul>
              <form class="lb-form" data-lb-form hidden>
                <label for="lbName"><span class="lang-es">¿Con qué nombre te anoto?</span><span class="lang-en">Name for the ranking?</span></label>
                <div class="lb-row">
                  <input id="lbName" data-lb-name type="text" maxlength="16" minlength="2" autocomplete="nickname" enterkeyhint="send" required />
                  <button type="submit" class="cy-btn solid"><span class="lang-es">Anotar</span><span class="lang-en">Save</span></button>
                </div>
                <button type="button" class="ov-link" data-lb-skip><span class="lang-es">Ahora no</span><span class="lang-en">Not now</span></button>
                <p class="lb-msg" data-lb-msg aria-live="polite"></p>
              </form>
              <p class="ov-rank" data-over-rank aria-live="polite"></p>
              <div class="ov-actions" data-over-actions>
                <button type="button" class="cy-btn solid" data-again><span set:html={RotateCcw} /><span class="lang-es">Otra vez</span><span class="lang-en">Again</span></button>
                <button type="button" class="ov-link" data-show-rank><span class="lang-es">Ver ranking</span><span class="lang-en">See ranking</span></button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel que gira -->
      <div class="sn-panel" data-panel data-face="now">
        <div class="sn-tabs" role="tablist">
          <button type="button" role="tab" data-face-btn="now" aria-selected="true"><span set:html={Music2} /><span class="lang-es">Sonando</span><span class="lang-en">Playing</span></button>
          <button type="button" role="tab" data-face-btn="rank" aria-selected="false"><span set:html={Trophy} /><span class="lang-es">Ranking</span><span class="lang-en">Ranking</span></button>
        </div>
        <div class="sn-flip">
          <div class="sn-face sn-front" data-face="now">
            <div class="deck" data-deck>
              <div class="deck-stage" aria-hidden="true">
                <div class="disc-wrap"><div class="disc"><span class="disc-label" data-deck-label></span></div></div>
                <div class="sleeve" data-deck-sleeve><img data-deck-art alt="" width="300" height="300" hidden /></div>
              </div>
              <div class="deck-meta">
                <a class="deck-t" data-deck-title target="_blank" rel="noopener">—</a>
                <p class="deck-a" data-deck-artist><span class="lang-es">Suena la carátula del tablero</span><span class="lang-en">Plays the cover on the board</span></p>
              </div>
            </div>
            <p class="sn-k sn-eaten-k"><span class="lang-es">Te comiste</span><span class="lang-en">You ate</span> <b data-eaten-count>0</b></p>
            <ol class="sn-mosaic" data-snake-list></ol>
            <p class="sn-foot has-music-only"><span class="lang-es">Previews de 30 s vía Deezer.</span><span class="lang-en">30 s previews via Deezer.</span></p>
            <p class="sn-foot no-music-only"><span class="lang-es">Hoy la música no cargó; se juega igual.</span><span class="lang-en">Music didn't load today; you can still play.</span></p>
          </div>
          <div class="sn-face sn-back" data-face="rank">
            <div class="rank">
              <p class="sn-k">Global</p>
              <ol class="rank-list" data-lb-global></ol>
              <p class="rank-empty" data-lb-off hidden><span class="lang-es">Pronto.</span><span class="lang-en">Coming soon.</span></p>
            </div>
            <div class="rank">
              <p class="sn-k"><span class="lang-es">En este dispositivo</span><span class="lang-en">On this device</span></p>
              <ol class="rank-list" data-lb-local></ol>
            </div>
            <div class="me" data-me hidden>
              <p class="me-line"><span class="lang-es">Te anotas como</span><span class="lang-en">You play as</span> <b data-me-name></b> <button type="button" class="ov-link" data-me-edit><span class="lang-es">cambiar</span><span class="lang-en">change</span></button></p>
              <form class="lb-row" data-me-form hidden>
                <input data-me-input type="text" maxlength="16" minlength="2" autocomplete="nickname" aria-label="Nombre" required />
                <button type="submit" class="cy-btn">OK</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
