---
// Rankings del Snake: global (validado en el servidor) y de este dispositivo.
// Datos y lógica: scripts/game/ranking.ts + /api/leaderboard.
---
<div class="ranks">
  <section class="rank" aria-labelledby="lbGlobalTitle">
    <h3 id="lbGlobalTitle" class="rank-title"><span class="lang-es">Ranking global</span><span class="lang-en">Global ranking</span></h3>
    <ol class="rank-list" data-lb-global></ol>
    <p class="rank-empty" data-lb-off hidden><span class="lang-es">Pronto.</span><span class="lang-en">Coming soon.</span></p>
  </section>
  <section class="rank" aria-labelledby="lbLocalTitle">
    <h3 id="lbLocalTitle" class="rank-title"><span class="lang-es">En este dispositivo</span><span class="lang-en">On this device</span></h3>
    <ol class="rank-list" data-lb-local></ol>
  </section>
</div>

<style>
  .ranks { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.5rem; }
  .rank { border: 1px solid var(--line); background: var(--panel); padding: 0.9rem 1rem; min-width: 0; }
  .rank-title { margin: 0 0 0.6rem; font-family: var(--font-mono); font-size: 0.66rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .rank-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .rank-list:empty::before { content: '—'; color: var(--ink-3); font-family: var(--font-mono); font-size: 0.8rem; }
  .rank-list :global(li) { display: grid; grid-template-columns: 1.8rem minmax(0, 1fr) auto; gap: 0.5rem; align-items: baseline; font-size: 0.85rem; }
  .rank-list :global(.pos) { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .rank-list :global(.who) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rank-list :global(.pts) { font-family: var(--font-mono); font-weight: 600; font-variant-numeric: tabular-nums; }
  .rank-list :global(li:first-child .pts) { color: var(--accent); }
  .rank-empty { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-3); }
  .rank-list[data-lb-global]:has(+ .rank-empty:not([hidden]))::before { content: none; }
  @media (max-width: 520px) { .ranks { grid-template-columns: 1fr; } }
</style>
