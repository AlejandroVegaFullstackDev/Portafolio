---
// 02 · Stack: tambor 3D de tecnologías que gira con el scroll (scripts/sections/stack.ts)
// + lista compacta por categoría y bloque de automatización. Datos: src/data/stack.ts.
import SectionHeading from '../ui/SectionHeading.astro';
import { portfolioData as D } from '../../data';

const S = D.stack;
const drum = [...S.languages, ...S.frameworks, ...S.databases, 'GCP', 'AWS', 'Docker', 'CI/CD'];
const groups = [
  { es: 'lenguajes', en: 'languages', items: S.languages },
  { es: 'frameworks', en: 'frameworks', items: S.frameworks },
  { es: 'arquitectura', en: 'architecture', items: S.architectures },
  { es: 'patrones', en: 'patterns', items: S.patterns },
  { es: 'datos', en: 'data', items: S.databases },
  { es: 'testing / ci', en: 'testing / ci', items: S.testing },
  { es: 'nube / devops', en: 'cloud / devops', items: S.cloud },
  { es: 'herramientas', en: 'tools', items: S.tools },
];
---
<section id="stack" class="relative px-6 lg:px-20 py-20 lg:py-28 border-y border-[var(--line)] bg-[var(--bg-2)] cy-scanlines overflow-hidden" data-wipe>
  <div class="max-w-[1480px] mx-auto stack-grid">
    <div class="stack-copy">
      <SectionHeading num="02" label={{ es: 'STACK', en: 'STACK' }} es={{ pre: 'Las herramientas que ', accent: 'domino', post: '.' }} en={{ pre: 'The tools I ', accent: 'master', post: '.' }} />
      <p class="font-mono text-sm text-[var(--ink-3)] max-w-sm mt-6">
        <span class="lang-es">Sin religiones tecnológicas. Elijo la herramienta correcta para el problema correcto.</span>
        <span class="lang-en">No tech religions. The right tool for the right problem.</span>
      </p>
    </div>

    <dl class="cats">
        {groups.map((g) => (
          <div class="cat" data-stagger-item>
            <dt><span class="lang-es">{g.es}</span><span class="lang-en">{g.en}</span></dt>
            <dd>{g.items.join(' · ')}</dd>
          </div>
        ))}
    </dl>

    <div class="drum-stage" aria-hidden="true" style={`--n:${drum.length}`}>
      <div class="drum" id="stackDrum">
        {drum.map((t, i) => <span class="drum-item" style={`--i:${i}`}>{t}</span>)}
      </div>
      <div class="drum-window"></div>
    </div>
  </div>

  <div class="max-w-[1480px] mx-auto auto-box">
    <div class="cy-eyebrow mb-4">// <span class="lang-es">{D.automation.title.es.toUpperCase()}</span><span class="lang-en">{D.automation.title.en.toUpperCase()}</span></div>
    <ol class="auto-list">
      {D.automation.items.es.map((_, i) => (
        <li data-stagger-item>
          <span class="auto-n">{String(i + 1).padStart(2, '0')} //</span>
          <span><span class="lang-es">{D.automation.items.es[i]}</span><span class="lang-en">{D.automation.items.en[i]}</span></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .stack-grid {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2.5rem 3rem; align-items: center;
    grid-template-areas: "copy drum" "cats drum";
  }
  .stack-copy { grid-area: copy; }
  .cats { grid-area: cats; margin: 0; border-top: 1px solid var(--line); align-self: start; }
  .drum-stage { grid-area: drum; }
  .cat { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--line); }
  .cat dt { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); padding-top: 0.2rem; }
  .cat dd { margin: 0; color: var(--ink-2); font-size: 0.92rem; line-height: 1.5; }

  /* Tambor: cada ítem rota alrededor del eje X y se empuja hacia afuera (radio R). */
  .drum-stage {
    --h: 52px; --R: calc(var(--h) * var(--n) / 6.2832);
    position: relative; height: calc(var(--R) * 2 + var(--h)); max-height: 560px;
    perspective: 1000px; display: grid; place-items: center;
    -webkit-mask: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
            mask: linear-gradient(180deg, transparent, #000 22%, #000 78%, transparent);
  }
  .drum { position: relative; width: 100%; height: var(--h); transform-style: preserve-3d; will-change: transform; }
  .drum-item {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem, 3vw, 2.2rem); letter-spacing: -0.03em;
    color: var(--ink); backface-visibility: hidden;
    transform: rotateX(calc(var(--i) * -360deg / var(--n))) translateZ(var(--R));
  }
  .drum-window {
    position: absolute; left: 0; right: 0; top: 50%; height: var(--h); transform: translateY(-50%);
    border-top: 1px solid var(--accent); border-bottom: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent); pointer-events: none;
  }

  .auto-box { margin-top: 3.5rem; border: 1px solid var(--line); padding: 1.5rem; background: linear-gradient(135deg, var(--panel), transparent); }
  .auto-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .auto-list li { display: flex; flex-direction: column; gap: 8px; color: var(--ink-2); line-height: 1.6; font-size: 0.95rem; }
  .auto-n { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em; color: var(--accent); }

  @media (max-width: 1023px) {
    .stack-grid { grid-template-columns: 1fr; gap: 1.5rem; grid-template-areas: "copy" "drum" "cats"; }
    .drum-stage { --h: 40px; max-height: 300px; }
    .auto-list { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 767px) {
    .cat { grid-template-columns: 1fr; gap: 0.2rem; }
    .auto-box { padding: 1.1rem; margin-top: 2rem; }
  }
</style>
