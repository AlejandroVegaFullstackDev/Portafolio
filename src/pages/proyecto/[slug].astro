---
// Página de caso de proyecto. Todo se renderiza en servidor (SEO y sin parpadeo);
// el cuerpo vive en components/project/CaseStudy.astro.
import Layout from '../../layouts/Layout.astro';
import SubpageBar from '../../components/layout/SubpageBar.astro';
import CaseStudy from '../../components/project/CaseStudy.astro';
import TweaksPanel from '../../components/TweaksPanel';
import { portfolioData as D } from '../../data';

export function getStaticPaths() {
  return D.projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = D.projects.find((x) => x.slug === slug)!;
const deep = (D.deep as Record<string, object>)[p.slug] ?? {};
const others = D.projects.filter((x) => x.slug !== p.slug).slice(0, 2);
const live = 'url' in p ? (p.url as string | undefined) : undefined;
const repo = 'github' in p ? (p.github as string | null | undefined) : undefined;
---
<Layout title={`${p.name.es} — Alejandro Vega`} description={`${p.name.es}: ${p.plain.es}`}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,600&display=swap" />
  <SubpageBar trail={`/ proyectos / ${p.slug}`} />

  <main>
    <section class="hero cy-grid">
      <div class="wrap">
        <p class="num">// PRJ_{p.n} · {p.year}</p>
        <h1 class="title"><span class="lang-es">{p.name.es}</span><span class="lang-en">{p.name.en}</span></h1>
        <p class="kicker"><span class="lang-es">{p.kicker.es}</span><span class="lang-en">{p.kicker.en}</span></p>
        <p class="summary"><span class="lang-es">{p.plain.es}</span><span class="lang-en">{p.plain.en}</span></p>
        <p class="tech"><span class="tech-label"><span class="lang-es">En detalle</span><span class="lang-en">In detail</span></span><span class="lang-es">{p.summary.es}</span><span class="lang-en">{p.summary.en}</span></p>
      </div>
    </section>

    <section class="meta">
      <dl class="wrap meta-grid">
        <div><dt><span class="lang-es">Rol</span><span class="lang-en">Role</span></dt><dd><span class="lang-es">{p.role.es}</span><span class="lang-en">{p.role.en}</span></dd></div>
        <div><dt><span class="lang-es">Año</span><span class="lang-en">Year</span></dt><dd>{p.year}</dd></div>
        <div>
          <dt>{live ? <><span class="lang-es">En vivo</span><span class="lang-en">Live</span></> : repo ? 'GitHub' : <><span class="lang-es">Código</span><span class="lang-en">Source</span></>}</dt>
          <dd>
            {live ? <a href={live} target="_blank" rel="noopener" class="link"><span class="lang-es">ver sitio ↗</span><span class="lang-en">visit site ↗</span></a>
              : repo ? <a href={repo} target="_blank" rel="noopener" class="link"><span class="lang-es">ver repo ↗</span><span class="lang-en">view repo ↗</span></a>
              : <span class="muted"><span class="lang-es">privado — trabajo de empresa</span><span class="lang-en">private — company work</span></span>}
          </dd>
        </div>
        <div><dt>Stack</dt><dd>{p.stack.slice(0, 3).join(' · ')}</dd></div>
      </dl>
    </section>

    <CaseStudy project={p} deep={deep} />

    <section class="next">
      <div class="wrap">
        <h2 class="next-title"><span class="lang-es">Otros proyectos</span><span class="lang-en">More projects</span></h2>
        <div class="next-grid">
          {others.map((o) => (
            <a href={`/proyecto/${o.slug}`} class="next-card">
              <span class="num">PRJ_{o.n} · {o.year}</span>
              <span class="next-name"><span class="lang-es">{o.name.es}</span><span class="lang-en">{o.name.en}</span></span>
              <span class="kicker sm"><span class="lang-es">{o.kicker.es}</span><span class="lang-en">{o.kicker.en}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap">
        <h2 class="cta-title"><span class="lang-es">Hablemos.</span><span class="lang-en">Let's talk.</span></h2>
        <div class="cta-links">
          <a href={D.identity.contact.linkedin} target="_blank" rel="noopener">LINKEDIN ↗</a>
          <a href="/alejandro-vega-cv-es.pdf" download class="lang-es">DESCARGAR CV ↓</a>
          <a href="/alejandro-vega-cv-en.pdf" download class="lang-en">DOWNLOAD CV ↓</a>
          <a href={D.identity.contact.github} target="_blank" rel="noopener">GITHUB ↗</a>
        </div>
      </div>
    </section>
  </main>

  <TweaksPanel client:only="react" />
</Layout>

<style>
  .wrap { max-width: 1400px; margin: 0 auto; }
  .hero { padding: clamp(3rem, 8vw, 5rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 7vw, 4.5rem); position: relative; overflow: hidden; }
  .num { font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.18em; color: var(--accent); text-transform: uppercase; margin: 0 0 1.25rem; }
  .title { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.6rem, 8vw, 7.5rem); line-height: 0.9; letter-spacing: -0.04em; margin: 0; text-wrap: balance; }
  .kicker { font-family: "Fraunces", Georgia, serif; font-style: italic; font-weight: 600; font-size: 1.5rem; color: var(--accent); margin: 1.5rem 0 0; }
  .kicker.sm { font-size: 1rem; margin: 0; }
  .summary { margin: 2rem 0 0; font-size: clamp(1.05rem, 2vw, 1.4rem); line-height: 1.6; color: var(--ink-2); max-width: 62ch; }
  .tech { margin: 1.5rem 0 0; max-width: 72ch; font-size: 0.95rem; line-height: 1.65; color: var(--ink-3); }
  .tech-label { display: block; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.35rem; }
  .meta { border-block: 1px solid var(--line); background: var(--bg-2); padding: 2rem clamp(1.25rem, 5vw, 4rem); }
  .meta-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; margin: 0 auto; }
  .meta dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.4rem; }
  .meta dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .link { color: var(--accent); font-size: 1rem; }
  .link:hover, .link:focus-visible { text-decoration: underline; text-underline-offset: 4px; }
  .muted { color: var(--ink-3); font-size: 0.95rem; font-weight: 400; }
  .next { padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 5vw, 4rem); border-top: 1px solid var(--line); }
  .next-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 4.5vw, 3.4rem); letter-spacing: -0.03em; margin: 0 0 2rem; }
  .next-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .next-card { display: flex; flex-direction: column; gap: 0.6rem; border: 1px solid var(--line); padding: 1.75rem; transition: border-color 0.3s, transform 0.3s; }
  .next-card:hover, .next-card:focus-visible { border-color: var(--accent); transform: translateY(-3px); }
  .next-card .num { margin: 0; }
  .next-name { font-family: var(--font-display); font-weight: 700; font-size: 1.8rem; letter-spacing: -0.02em; }
  .cta { background: var(--accent); color: #000; padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 5vw, 4rem); }
  .cta-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 10vw, 8rem); line-height: 0.9; letter-spacing: -0.04em; margin: 0; }
  .cta-links { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .cta-links a { font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.12em; padding: 0.75rem 1.4rem; border: 1px solid #000; transition: background-color 0.2s, color 0.2s; }
  .cta-links a:first-child { background: #000; color: #fff; }
  .cta-links a:hover, .cta-links a:focus-visible { background: #000; color: var(--accent); }
  @media (max-width: 900px) {
    .meta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .next-grid { grid-template-columns: 1fr; }
  }
</style>
