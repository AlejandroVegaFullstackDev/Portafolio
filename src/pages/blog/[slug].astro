---
// Página de un post. Encabezado y barra lateral son componentes (components/blog);
// los estilos del contenido Markdown viven en styles/prose.css.
import Layout from '../../layouts/Layout.astro';
import PostHeader from '../../components/blog/PostHeader.astro';
import PostSidebar from '../../components/blog/PostSidebar.astro';
import { getCollection, render } from 'astro:content';
import { getToc, readingTime } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const toc = getToc(post.body);
---
<Layout title={`${post.data.title} — Alejandro Vega`} description={post.data.description} image={post.data.cover} type="article">
  <div id="read-bar" aria-hidden="true"></div>

  <nav class="nav" aria-label="Navegación del post">
    <a href="/blog" class="nav-back">← blog</a>
    <span class="nav-rt">{readingTime(post.body)} min de lectura</span>
    <a href="/" class="nav-logo">AV/_</a>
  </nav>

  <main>
    <PostHeader post={post} />

    <div class="layout">
      <article class="prose">
        <div class="sticky-side">
          <img src="/blog/sidebar-sticky.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <Content />
      </article>
      <PostSidebar toc={toc} />
    </div>

    <footer class="foot">
      <a href="/blog" class="foot-link">← todos los posts</a>
      <a href="/" class="foot-link accent">AV/_ ↗</a>
    </footer>
  </main>
</Layout>

<script>
  import { initBlogPost } from '../../scripts/blogPost';
  initBlogPost();
</script>

<style>
  #read-bar { position: fixed; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); z-index: 1000; transform: scaleX(0); transform-origin: left; }
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: 52px; padding: 0 1.5rem;
    display: flex; align-items: center; justify-content: space-between;
    background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line);
  }
  .nav-back, .nav-logo { font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.12em; color: var(--ink-3); transition: color 0.2s; }
  .nav-back:hover, .nav-logo:hover { color: var(--accent); }
  .nav-rt { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-3); }

  .layout { display: grid; grid-template-columns: 1fr; gap: 3rem; max-width: 860px; margin: 0 auto; padding: 1.5rem 1.5rem 5rem; }
  .sticky-side { display: none; }

  .foot { max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem 5rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .foot-link { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; color: var(--ink-3); transition: color 0.2s; }
  .foot-link:hover { color: var(--accent); }
  .foot-link.accent { color: var(--accent); }

  @media (min-width: 1024px) {
    .layout { grid-template-columns: 1fr 220px; gap: 4rem; padding: 1.5rem 2rem 6rem; max-width: 1100px; align-items: start; }
    .sticky-side { display: block; position: sticky; top: 100px; align-self: start; margin-bottom: 2rem; }
    .sticky-side img { width: 50%; max-width: none; object-fit: cover; border: 0; background: transparent; }
    .foot { padding: 2rem 2rem 5rem; }
  }
</style>
