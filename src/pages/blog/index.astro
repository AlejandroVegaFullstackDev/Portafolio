---
// /blog: encabezado + lista (components/blog/PostList.astro). Efectos en scripts/blogIndex.ts.
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/blog/PostList.astro';
import { getSortedPosts } from '../../lib/blog';

const posts = await getSortedPosts();
---

<Layout title="Blog — Alejandro Vega" description="Notas de Alejandro Vega sobre código, IA y lo que va aprendiendo.">
  <main style="min-height:100vh;">
    <!-- Header -->
    <div class="blog-header">
      <div class="blog-bg-word" aria-hidden="true">BLOG</div>
      <div style="max-width:1200px;margin:0 auto;position:relative;z-index:1;">
        <a href="/" class="blog-back">← AV/_</a>
        <div class="blog-accent-bar"></div>
        <div class="blog-eyebrow">// BLOG</div>
        <h1 class="blog-h1">Notas<br/>sueltas.</h1>
        <div class="blog-meta-strip">
          <span>{posts.length} {posts.length === 1 ? 'entrada' : 'entradas'}</span>
          <span class="dot-sep">·</span>
          <span>programación</span>
          <span class="dot-sep">·</span>
          <span>música</span>
          <span class="dot-sep">·</span>
          <span>vida</span>
          <span class="dot-sep">·</span>
          <span>historia</span>
        </div>
      </div>
    </div>

    <PostList posts={posts} />
  </main>
</Layout>

<script>
  import { initBlogIndex } from '../../scripts/blogIndex';
  initBlogIndex();
</script>

<style>
  body { background: var(--bg); }

  /* Header */
  .blog-header {
    border-bottom: 1px solid var(--line);
    padding: 5rem 1.5rem 3.5rem;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .blog-header { padding: 6rem 5rem 4rem; }
  }
  .blog-bg-word {
    position: absolute;
    right: -0.04em;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(10rem, 22vw, 20rem);
    line-height: 1;
    color: var(--line);
    letter-spacing: -0.04em;
    select: none;
    pointer-events: none;
    user-select: none;
  }
  .blog-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 0.2s;
  }
  .blog-back:hover { color: var(--accent); }
  .blog-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .blog-h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--ink);
  }
  .blog-meta-strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }
  .blog-meta-strip .dot-sep { color: var(--line-2); }


  /* ─── 3D ─── */
  .blog-header { perspective: 1200px; }
  .blog-bg-word {
    transform-style: preserve-3d;
    will-change: transform;
    text-shadow:
      1px 1px 0 var(--line-2), 2px 2px 0 var(--line-2), 3px 3px 0 var(--line-2),
      4px 4px 0 var(--line-2), 5px 5px 0 var(--line-2), 6px 6px 0 var(--line-2),
      7px 7px 0 var(--line-2), 8px 8px 0 var(--bg-2),
      14px 18px 28px rgba(255, 0, 60, 0.18);
  }

  /* Theme accent line at top */
  .blog-accent-bar {
    height: 2px;
    background: var(--accent);
    width: 56px;
    margin-bottom: 1.5rem;
  }
</style>
