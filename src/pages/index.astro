  function addLines(lines: string[], cls = '') { lines.forEach((l) => addLine(l, cls)); }

  // Matrix rain
  let matrixActive = false;
  const overlay = document.createElement('canvas');
  overlay.className = 'tg-overlay';
  overlay.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;display:none;';

  function startMatrix() {
    if (matrixActive) return;
    matrixActive = true;
    overlay.style.display = 'block';
    overlay.width = screen.offsetWidth;
    overlay.height = screen.offsetHeight;
    const ctx = overlay.getContext('2d')!;
    const cols = Math.floor(overlay.width / 14);
    const drops = Array(cols).fill(1);
    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789';
    const iv = setInterval(() => {
      if (!matrixActive) { clearInterval(iv); overlay.style.display = 'none'; return; }
      ctx.fillStyle = 'rgba(0,0,0,0.05)';
      ctx.fillRect(0, 0, overlay.width, overlay.height);
      ctx.fillStyle = '#0f0';
      ctx.font = '12px monospace';
      drops.forEach((y, x) => {
        ctx.fillText(chars[Math.floor(Math.random() * chars.length)], x * 14, y * 14);
        if (y * 14 > overlay.height && Math.random() > 0.975) drops[x] = 0;
        drops[x]++;
      });
    }, 50);
    setTimeout(() => { matrixActive = false; }, 4000);
  }

  // Snake game
  let snakeActive = false;
  function startSnake() {
    if (snakeActive) return;
    snakeActive = true;
    addLine(lang === 'en' ? '▶ Snake started. Arrow keys to move. Press Q to quit.' : '▶ Snake iniciado. Flechas para mover. Q para salir.', 'tg-hack');
    const W = 20, H = 10;
    let snake = [{x:10,y:5},{x:9,y:5},{x:8,y:5}];
    let food = {x:Math.floor(Math.random()*W),y:Math.floor(Math.random()*H)};
    let dir = {x:1,y:0};
    let score = 0;
    const gameDiv = document.createElement('div');
    gameDiv.style.cssText = 'font-family:monospace;font-size:12px;line-height:1.2;color:#0f0;margin:4px 0;';
    screen.insertBefore(gameDiv, prompt);
    function render() {
      const grid = Array.from({length:H},()=>Array(W).fill('·'));
      snake.forEach(s=>{if(s.y>=0&&s.y<H&&s.x>=0&&s.x<W)grid[s.y][s.x]='█';});
      if(food.y>=0&&food.y<H&&food.x>=0&&food.x<W)grid[food.y][food.x]='●';
      gameDiv.textContent=grid.map(r=>r.join('')).join('\n')+`\n${lang==='en'?'Score':'Puntaje'}: ${score}`;
    }
    const keyH = (e: KeyboardEvent)=>{
      if(!snakeActive)return;
      if(e.key==='ArrowUp'&&dir.y===0)dir={x:0,y:-1};
      else if(e.key==='ArrowDown'&&dir.y===0)dir={x:0,y:1};
      else if(e.key==='ArrowLeft'&&dir.x===0)dir={x:-1,y:0};
      else if(e.key==='ArrowRight'&&dir.x===0)dir={x:1,y:0};
      else if(e.key==='q'||e.key==='Q'){snakeActive=false;document.removeEventListener('keydown',keyH);gameDiv.remove();}
    };
    document.addEventListener('keydown',keyH);
    const iv = setInterval(()=>{
      if(!snakeActive){clearInterval(iv);return;}
      const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};
      if(head.x<0||head.x>=W||head.y<0||head.y>=H||snake.some(s=>s.x===head.x&&s.y===head.y)){
        snakeActive=false;clearInterval(iv);document.removeEventListener('keydown',keyH);
        gameDiv.remove();addLine(`GAME OVER · ${lang==='en'?'Score':'Puntaje'}: ${score}`,'tg-err');return;
      }
      snake.unshift(head);
      if(head.x===food.x&&head.y===food.y){score++;food={x:Math.floor(Math.random()*W),y:Math.floor(Math.random()*H)};}
      else snake.pop();
      render();
    },120);
    render();
  }

  // Hack sequence
  function startHack() {
    const steps = lang === 'en'
      ? ['Scanning target...','Bypassing firewall...','Injecting payload...','Escalating privileges...','ACCESS GRANTED — welcome, hacker.']
      : ['Escaneando objetivo...','Saltando firewall...','Inyectando payload...','Escalando privilegios...','ACCESO CONCEDIDO — bienvenido, hacker.'];
    let i = 0;
    function next() {
      if (i >= steps.length) return;
      addLine(steps[i++], 'tg-hack');
      setTimeout(next, 400 + Math.random() * 400);
    }
    next();
  }

  // DOOM easter egg
  function startDoom() {
    const logo = [
      '██████╗  ██████╗  ██████╗ ███╗   ███╗',
      '██╔══██╗██╔═══██╗██╔═══██╗████╗ ████║',
      '██║  ██║██║   ██║██║   ██║██╔████╔██║',
      '██║  ██║██║   ██║██║   ██║██║╚██╔╝██║',
      '██████╔╝╚██████╔╝╚██████╔╝██║ ╚═╝ ██║',
      '╚═════╝  ╚═════╝  ╚═════╝ ╚═╝     ╚═╝',
    ];
    logo.forEach(l => addLine(l, 'tg-doom'));
    const steps = lang === 'en'
      ? ['', 'LOADING HELL...  please wait',
         '[░░░░░░░░░░░░░░░░░░░░]   0%',
         '[████░░░░░░░░░░░░░░░░]  20%',
         '[████████░░░░░░░░░░░░]  40%',
         '[████████████░░░░░░░░]  60%',
         '[████████████████░░░░]  80%',
         '[████████████████████] 100%', '',
         'ERROR: PC_TOO_SLOW',
         'REQUIRED: PENTIUM 90MHz · 4MB RAM · VGA',
         'FOUND:    🐌  PATHETIC HARDWARE', '',
         '>>> TOO SLOW. GET A REAL PC. <<<']
      : ['', 'CARGANDO EL INFIERNO...  por favor espera',
         '[░░░░░░░░░░░░░░░░░░░░]   0%',
         '[████░░░░░░░░░░░░░░░░]  20%',
         '[████████░░░░░░░░░░░░]  40%',
         '[████████████░░░░░░░░]  60%',
         '[████████████████░░░░]  80%',
         '[████████████████████] 100%', '',
         'ERROR: PC_DEMASIADO_LENTO',
         'REQUERIDO: PENTIUM 90MHz · 4MB RAM · VGA',
         'ENCONTRADO: 🐌  HARDWARE PATÉTICO', '',
         '>>> DEMASIADO LENTO. CONSIGUE UN PC REAL. <<<'];
    const delays = [0,200,120,160,140,160,140,220,100,350,280,340,180,600];
    let i = 0;
    function next() {
      if (i >= steps.length) return;
      const s = steps[i], d = delays[i] ?? 200; i++;
      const cls = s.startsWith('>>>') ? 'tg-hack'
        : (s.startsWith('ERROR') || s.startsWith('REQUIRED') || s.startsWith('FOUND')
           || s.startsWith('REQUERIDO') || s.startsWith('ENCONTRADO')) ? 'tg-err' : 'tg-echo';
      addLine(s || ' ', cls);
      setTimeout(next, d);
    }
    setTimeout(next, 80);
  }

  const prompt = document.createElement('div');
  prompt.className = 'tg-prompt';
  const ps1 = document.createElement('span');
  ps1.className = 'tg-ps1';
  ps1.textContent = '▸';
  const input = document.createElement('input');
  input.className = 'tg-input';
  input.type = 'text';
  input.autocomplete = 'off';
  input.spellcheck = false;
  prompt.appendChild(ps1);
  prompt.appendChild(input);
  screen.appendChild(prompt);
  container.appendChild(overlay);
  container.appendChild(screen);

  addLine(lang === 'en' ? 'stackblend.shell v1.0 — type "help" to start' : 'stackblend.shell v1.0 — escribe "help" para comenzar');

  screen.addEventListener('click', () => input.focus());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const cmd = input.value.trim().toLowerCase();
      input.value = '';
      if (!cmd) return;
      cmdHistory.unshift(cmd);
      histIdx = -1;
      addLine('▸ ' + cmd, 'tg-echo');
      if (cmd === 'clear') { history.forEach((l) => l.remove()); history.length = 0; return; }
      if (cmd === 'matrix') { startMatrix(); return; }
      if (cmd === 'snake') { startSnake(); return; }
      if (cmd === 'hack') { startHack(); return; }
      if (cmd === 'doom') { startDoom(); return; }
      const fn = COMMANDS[cmd];
      if (fn) addLines(fn([], lang));
      else addLine(lang === 'en' ? `Command not found: ${cmd}. Type "help".` : `Comando no encontrado: ${cmd}. Escribe "help".`, 'tg-err');
    }
    if (e.key === 'ArrowUp') { histIdx = Math.min(histIdx + 1, cmdHistory.length - 1); input.value = cmdHistory[histIdx] || ''; }
    if (e.key === 'ArrowDown') { histIdx = Math.max(histIdx - 1, -1); input.value = histIdx >= 0 ? cmdHistory[histIdx] : ''; }
  });
}

// ─── Spotify now-playing ──────────────────────────────────────────────────────
function initSpotify() {
  const trackEl = document.getElementById('nowTrackText') as HTMLElement | null;
  const iconEl  = document.getElementById('nowPlayIcon')  as HTMLElement | null;
  if (!trackEl || !iconEl) return;

  async function tick() {
    try {
      const res  = await fetch('/api/spotify');
      if (!res.ok) return;
      const data = await res.json() as {
        isPlaying: boolean; title?: string; artist?: string;
        songUrl?: string; configured?: boolean;
      };

      if (!data.isPlaying || !data.title) {
        const lang = getLang();
        trackEl.innerHTML = lang === 'es' ? '— SIN REPRODUCCIÓN ACTIVA' : '— NOT PLAYING NOW';
        iconEl.textContent = '⏸';
        return;
      }

      const trunc = (s: string, n: number) => s.length > n ? s.slice(0, n) + '…' : s;
      const artist = trunc(data.artist ?? '', 24);
      const title  = trunc(data.title ?? '', 28);
      const label  = `${artist} — ${title}`;

      iconEl.textContent = '▶';
      if (data.songUrl) {
        trackEl.innerHTML =
          `<a href="${data.songUrl}" target="_blank" rel="noopener"
              style="color:inherit;text-decoration:none;display:inline;">${label}</a>`;
      } else {
        trackEl.textContent = label;
      }
    } catch {
      // keep static fallback silently
    }
  }

  tick();
  setInterval(tick, 30_000);
}

// ─── Char-level reveal for accent words in section headings ─────────────────
function initCharReveal() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;
  document.querySelectorAll<HTMLElement>('section h2 .text-\\[var\\(--accent\\)\\]').forEach((el) => {
    if (el.classList.contains('cy-glitch')) return;
    const text = el.textContent || '';
    if (!text.trim()) return;
    el.innerHTML = text.split('').map((c) =>
      `<span style="display:inline-block;will-change:transform">${c}</span>`
    ).join('');
    const h2 = el.closest('h2') || el;
    ScrollTrigger.create({
      trigger: h2,
      start: 'top 82%', once: true,
      onEnter: () => {
        gsap.from(el.querySelectorAll('span'), {
          y: 55, opacity: 0, rotateX: -80, scaleY: 0.3,
          transformPerspective: 500,
          duration: 0.65, stagger: 0.05, ease: 'expo.out', delay: 0.3,
        });
      },
    });
  });
}

// ─── Continuous wave on hero name chars ──────────────────────────────────────
function initWaveHero() {
  const anim = document.documentElement.getAttribute('data-tweak-anim');
  if (anim === 'off' || anim === 'low') return;
  const chars = document.querySelectorAll<HTMLElement>('#heroName .hc');
  if (!chars.length) return;
  gsap.to(chars, {
    y: -6,
    duration: 0.88,
    ease: 'sine.inOut',
    stagger: { each: 0.065, repeat: -1, yoyo: true },
    delay: 1.6,
  });
}

// ─── Spotlight ────────────────────────────────────────────────────────────────
function initSpotlight() {
  if (window.matchMedia('(hover: none)').matches) return;
  const el = document.createElement('div');
  el.className = 'cy-spotlight';
  document.body.appendChild(el);
  window.addEventListener('mousemove', (e) => {
    gsap.to(el, { x: e.clientX, y: e.clientY, duration: 1.4, ease: 'power3.out' });
  });
}

// ─── 3-D tilt on project tiles & service cards ────────────────────────────────
function init3DTiles() {
  if (window.matchMedia('(hover: none)').matches) return;
  document.querySelectorAll<HTMLElement>('.cy-tile, .service-card').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const y = ((e.clientY - r.top) / r.height - 0.5) * 2;
      gsap.to(el, { rotateX: -y * 7, rotateY: x * 7, transformPerspective: 900, duration: 0.45, ease: 'power3.out' });
    });
    el.addEventListener('mouseleave', () => {
      gsap.to(el, { rotateX: 0, rotateY: 0, duration: 0.9, ease: 'elastic.out(1,0.35)' });
    });
  });
}

// ─── Periodic hero name glitch ────────────────────────────────────────────────
function initHeroGlitch() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;
  function glitch() {
    const chars = Array.from(document.querySelectorAll<HTMLElement>('#heroName .hc'));
    if (!chars.length) return;
    const picked = chars.filter(() => Math.random() > 0.75);
    if (!picked.length) return;
    gsap.to(picked, {
      x: () => gsap.utils.random(-8, 8),
      skewX: () => gsap.utils.random(-7, 7),
      color: () => Math.random() > 0.4 ? 'var(--accent)' : 'var(--ink)',
      duration: 0.07, ease: 'none',
      onComplete: () => gsap.to(picked, { x: 0, skewX: 0, color: 'var(--ink)', duration: 0.15, ease: 'power2.out' }),
    });
  }
  gsap.delayedCall(2.8, () => setInterval(() => { if (Math.random() < 0.4) glitch(); }, 2500));
}

// ─── Now clock (live Bogotá time) ─────────────────────────────────────────────
function initNowClock() {
  const el = document.getElementById('nowClock');
  if (!el) return;
  function tick() {
    el.textContent = new Date().toLocaleTimeString('es-CO', {
      timeZone: 'America/Bogota', hour: '2-digit', minute: '2-digit', second: '2-digit',
    });
  }
  tick();
  setInterval(tick, 1000);
}

// ─── Now band entrance animation ──────────────────────────────────────────────
function initNowBand() {
  gsap.from('#nowBand .now-item', {
    x: 30, opacity: 0, duration: 0.55, stagger: 0.1, ease: 'expo.out', delay: 1.5,
  });
}

// ─── Cursor trail ─────────────────────────────────────────────────────────────
function initCursorTrail() {
  if (window.matchMedia('(hover: none)').matches) return;
  if (document.documentElement.hasAttribute('data-tweak-nocursor')) return;
  const TRAIL = 6;
  const dots: HTMLElement[] = [];
  const pos: {x:number,y:number}[] = [];
  for (let i = 0; i < TRAIL; i++) {
    const d = document.createElement('div');
    d.className = 'cy-trail';
    d.style.opacity = String(0.5 - i * 0.07);
    d.style.transform = `translate(-50%,-50%) scale(${1 - i * 0.12})`;
    document.body.appendChild(d);
    dots.push(d);
    pos.push({ x: 0, y: 0 });
  }
  let mx = 0, my = 0;
  window.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
  gsap.ticker.add(() => {
    pos[0].x += (mx - pos[0].x) * 0.35;
    pos[0].y += (my - pos[0].y) * 0.35;
    for (let i = 1; i < TRAIL; i++) {
      pos[i].x += (pos[i-1].x - pos[i].x) * 0.45;
      pos[i].y += (pos[i-1].y - pos[i].y) * 0.45;
    }
    dots.forEach((d, i) => { d.style.transform = `translate(${pos[i].x}px,${pos[i].y}px) translate(-50%,-50%)`; });
  });
}

// ─── Hero parallax ────────────────────────────────────────────────────────────
function initHeroPin() {
  if (document.documentElement.getAttribute('data-tweak-anim') !== 'high') return;
  const name = document.getElementById('heroName');
  if (!name) return;
  gsap.to(name, { yPercent: -15, ease: 'none', scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true } });
}

// ─── Main ─────────────────────────────────────────────────────────────────────
async function start() {
  await bootSequence();
  paintHero();
  paintAbout();
  paintStack();
  paintServices();
  paintExp();
  paintProjects();

  // GSAP animations
  initCursor();
  initScramble();
  initMarquees();
  initReveals();
  initMagnetic();
  initCounters();
  initHeroPin();
  initExpAnimations();
  initServicesAnimations();
  initProjectAnimations();
  initEyebrows();
  initSpotlight();
  initCursorTrail();
  init3DTiles();
  initHeroGlitch();
  initCharReveal();
  initWaveHero();
  initNowClock();
  initSpotify();
  initNowBand();

  // Hero name char-by-char reveal — more dramatic stagger
  gsap.from('#heroName .hc', { yPercent: 120, rotateX: -40, duration: 0.9, ease: 'expo.out', stagger: 0.025, delay: 0.1 });
  gsap.from('#hero p', { y: 30, opacity: 0, duration: 0.9, ease: 'expo.out', delay: 0.7 });
  gsap.from('#hero .cy-btn', { y: 24, opacity: 0, scale: 0.9, duration: 0.7, stagger: 0.12, ease: 'expo.out', delay: 0.9 });
  gsap.from('#hero .grid > div', { y: 40, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'expo.out', delay: 1.1 });

  // Lang toggle
  const langBtn = document.getElementById('langToggle');
  if (langBtn) {
    langBtn.addEventListener('click', () => {
      setLang(getLang() === 'es' ? 'en' : 'es');
      paintAbout(); paintStack(); paintServices(); paintExp(); paintProjects();
      init3DTiles();
      // Rebuild hero term and game with new lang
      const heroTerm = document.getElementById('heroTerm');
      if (heroTerm) { heroTerm.innerHTML = ''; paintHero(); }
      const tg = document.getElementById('termGame');
      if (tg) { tg.innerHTML = ''; attachTerminalGame(tg, getLang()); }
    });
  }

  // Terminal game
  const tg = document.getElementById('termGame');
  if (tg) attachTerminalGame(tg, getLang());

  setTimeout(() => ScrollTrigger.refresh(), 200);
}

start();
</script>
