<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { portfolioData as D } from '../lib/data';

gsap.registerPlugin(ScrollTrigger);

// ─── i18n ───────────────────────────────────────────────────────────────────
const LANG_KEY = 'av_lang';
const getLang = (): 'es' | 'en' => (localStorage.getItem(LANG_KEY) as 'es' | 'en') || 'es';
const setLang = (lang: 'es' | 'en') => {
  localStorage.setItem(LANG_KEY, lang);
  document.documentElement.setAttribute('data-lang', lang);
};
document.documentElement.setAttribute('data-lang', getLang());

// ─── Cursor ─────────────────────────────────────────────────────────────────
function initCursor() {
  if (document.documentElement.hasAttribute('data-tweak-nocursor')) return;
  const cursor = document.createElement('div');
  cursor.className = 'cy-cursor';
  document.body.appendChild(cursor);
  let tx = 0, ty = 0, x = 0, y = 0;
  window.addEventListener('mousemove', (e) => { tx = e.clientX; ty = e.clientY; });
  gsap.ticker.add(() => {
    x += (tx - x) * 0.22;
    y += (ty - y) * 0.22;
    cursor.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
  });
  document.addEventListener('mouseover', (e) => {
    const t = e.target as Element;
    if (t?.closest?.('a, button, .cy-btn, .cy-tile, [data-cursor]')) cursor.classList.add('hover');
  });
  document.addEventListener('mouseout', (e) => {
    const t = e.target as Element;
    if (t?.closest?.('a, button, .cy-btn, .cy-tile, [data-cursor]')) cursor.classList.remove('hover');
  });
}

// ─── Text scramble ──────────────────────────────────────────────────────────
const SCRAMBLE_CHARS = '!<>-_\\/[]{}—=+*^?#________ABCDEF0123456789';
function scramble(el: HTMLElement, finalText: string) {
  const finalArr = finalText.split('');
  let frame = 0;
  const queue = finalArr.map((c, i) => ({
    to: c, from: (el as any)._prev ? ((el as any)._prev[i] || '') : '',
    start: Math.floor(Math.random() * 18), end: Math.floor(Math.random() * 30) + 18,
  }));
  let raf: number;
  function update() {
    let out = '', complete = 0;
    for (const { to, start, end } of queue) {
      if (frame >= end) { complete++; out += to; }
      else if (frame >= start) out += SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
      else out += ' ';
    }
    el.textContent = out;
    if (complete === queue.length) { (el as any)._prev = finalText; return; }
    frame++;
    raf = requestAnimationFrame(update);
  }
  cancelAnimationFrame(raf!);
  update();
}

function initScramble() {
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const langEl = el.querySelector<HTMLElement>(`.lang-${getLang()}`);
    const txt = (langEl ? langEl.textContent : el.textContent) || '';
    (el as any)._scrambleText = txt;
    el.innerHTML = '';
    ScrollTrigger.create({ trigger: el, start: 'top 85%', once: true, onEnter: () => scramble(el, (el as any)._scrambleText) });
  });
}

// ─── Marquee ────────────────────────────────────────────────────────────────
function initMarquees() {
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => {
    const speed = parseFloat(el.dataset.marquee || '60');
    const inner = el.firstElementChild as HTMLElement;
    if (!inner) return;
    const dup = inner.cloneNode(true) as HTMLElement;
    dup.setAttribute('aria-hidden', 'true');
    el.appendChild(dup);
    const w = inner.getBoundingClientRect().width;
    gsap.to(Array.from(el.children), { x: -w, duration: w / speed, ease: 'none', repeat: -1 });
  });
}

// ─── Reveals — horizontal blur wipe ────────────────────────────────────────
function initReveals() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
    gsap.fromTo(el,
      { clipPath: 'inset(0 100% 0 0)', filter: 'blur(16px)', x: -24 },
      { clipPath: 'inset(0 0% 0 0)', filter: 'blur(0px)', x: 0,
        duration: 1.35, ease: 'expo.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true } }
    );
  });

  // Stagger groups — scale + blur fade
  document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((g) => {
    const items = g.querySelectorAll('[data-stagger-item]');
    gsap.fromTo(items,
      { y: 60, opacity: 0, scale: 0.92, filter: 'blur(6px)' },
      { y: 0, opacity: 1, scale: 1, filter: 'blur(0px)',
        duration: 0.9, stagger: 0.09, ease: 'expo.out',
        scrollTrigger: { trigger: g, start: 'top 82%', once: true } }
    );
  });
}

// ─── Experience stagger ───────────────────────────────────────────────────────
function initExpAnimations() {
  const rows = document.querySelectorAll('.exp-row');
  if (!rows.length) return;
  gsap.fromTo(rows,
    { x: -40, opacity: 0 },
    { x: 0, opacity: 1, duration: 0.75, stagger: 0.12, ease: 'expo.out',
      scrollTrigger: { trigger: '#expList', start: 'top 82%', once: true } }
  );
}


// ─── Section eyebrow lines ────────────────────────────────────────────────────
function initEyebrows() {
  document.querySelectorAll<HTMLElement>('.cy-eyebrow:not([data-scramble])').forEach((el) => {
    gsap.fromTo(el,
      { opacity: 0, x: -20 },
      { opacity: 1, x: 0, duration: 0.7, ease: 'expo.out',
        scrollTrigger: { trigger: el, start: 'top 90%', once: true } }
    );
  });
}

// ─── Magnetic buttons ───────────────────────────────────────────────────────
function initMagnetic() {
  document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      gsap.to(el, { x: (e.clientX - (r.left + r.width/2)) * 0.18, y: (e.clientY - (r.top + r.height/2)) * 0.22, duration: 0.4, ease: 'power3.out' });
    });
    el.addEventListener('mouseleave', () => gsap.to(el, { x:0, y:0, duration:0.6, ease:'elastic.out(1,0.4)' }));
  });
}

// ─── Counters ───────────────────────────────────────────────────────────────
function initCounters() {
  document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
    const target = parseFloat(el.dataset.counter || '0');
    const prefix = el.dataset.counterPrefix || '';
    const suffix = el.dataset.counterSuffix || '';
    const decimals = parseInt(el.dataset.counterDecimals || '0');
    const fmt = (v: number) => (decimals > 0 ? v.toFixed(decimals) : Math.round(v).toLocaleString('es-CO'));
    const obj = { v: 0 };
    // Counters live in the hero viewport — skip ScrollTrigger, animate with delay
    gsap.to(obj, { v: target, duration: 1.6, ease: 'expo.out', delay: 1.2,
      onUpdate: () => { el.textContent = prefix + fmt(obj.v) + suffix; } });
  });
}

// ─── Scroll progress bar ──────────────────────────────────────────────────────
function initScrollProgress() {
  if (document.getElementById('cyScrollProgress')) return;
  const bar = document.createElement('div');
  bar.id = 'cyScrollProgress';
  bar.style.cssText = 'position:fixed;top:0;left:0;height:2px;width:0%;background:var(--accent);z-index:9999;box-shadow:0 0 12px var(--accent);pointer-events:none;transform-origin:left;will-change:width;';
  document.body.appendChild(bar);
  gsap.to(bar, { width: '100%', ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: 0.3 } });
}

// ─── Project cards — 3D tilt + cursor-tracked shine ───────────────────────────
function initProjectTilt() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;
  if (window.matchMedia('(pointer: coarse)').matches) return;
  document.querySelectorAll<HTMLElement>('.proj-card').forEach((card) => {
    if ((card as any)._tilt) return;
    (card as any)._tilt = true;
    card.style.transformStyle = 'preserve-3d';
    if (getComputedStyle(card).position === 'static') card.style.position = 'relative';
    const shine = document.createElement('div');
    shine.style.cssText = 'position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;transition:opacity 0.35s;will-change:opacity;';
    card.appendChild(shine);
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      gsap.to(card, { rotateY: (px - 0.5) * 9, rotateX: -(py - 0.5) * 9, transformPerspective: 900, duration: 0.4, ease: 'power3.out' });
      shine.style.background = `radial-gradient(circle at ${px * 100}% ${py * 100}%, var(--accent), transparent 55%)`;
      shine.style.opacity = '0.14';
    });
    card.addEventListener('mouseleave', () => {
      gsap.to(card, { rotateY: 0, rotateX: 0, duration: 0.8, ease: 'elastic.out(1,0.4)' });
      shine.style.opacity = '0';
    });
  });
}

// ─── Stack cells — lift + chip pop on hover ───────────────────────────────────
function initStackHover() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;
  document.querySelectorAll<HTMLElement>('.stack-cell').forEach((cell) => {
    if ((cell as any)._hov) return;
    (cell as any)._hov = true;
    const chips = cell.querySelectorAll('li');
    cell.addEventListener('mouseenter', () => {
      gsap.to(cell, { y: -6, borderColor: 'var(--accent)', duration: 0.3, ease: 'power3.out' });
      gsap.fromTo(chips, { scale: 0.88 }, { scale: 1, stagger: 0.02, duration: 0.3, ease: 'back.out(2.2)' });
    });
    cell.addEventListener('mouseleave', () => {
      gsap.to(cell, { y: 0, borderColor: 'var(--line)', duration: 0.45, ease: 'power2.out' });
    });
  });
}


// ─── Boot sequence ──────────────────────────────────────────────────────────
function bootSequence(): Promise<void> {
  const boot = document.getElementById('boot');
  const log = document.getElementById('bootLog');
  if (!boot || !log) return Promise.resolve();
  const lines = [
    '[ OK ]  loading kernel modules ...',
    '[ OK ]  init: spawning init.d',
    '[ OK ]  mount /home/alejandro',
    '[ OK ]  starting 4ledmt-os',
    '[ OK ]  loading runtime: php · python · node · ts',
    '[ OK ]  loading drivers: postgresql · mysql · bigquery',
    '[ OK ]  authenticating: 4ledmt.dev .....',
    '[ OK ]  ACCESS GRANTED.',
    '',
    '> launching portfolio.exe',
  ];
  return new Promise((resolve) => {
    let i = 0;
    const tick = () => {
      if (i >= lines.length) {
        setTimeout(() => {
          gsap.to(boot, { opacity: 0, duration: 0.6, ease: 'power2.out', onComplete: () => { boot.style.display = 'none'; resolve(); } });
        }, 240);
        return;
      }
      const l = document.createElement('div');
      l.textContent = lines[i++];
      log.appendChild(l);
      setTimeout(tick, 90 + Math.random() * 90);
    };
    tick();
  });
}

// ─── Hero ────────────────────────────────────────────────────────────────────
function paintHero() {
  const nameEl = document.getElementById('heroName');
  if (nameEl) {
    const mkLine = (text: string, accent = '') =>
      `<span class="reveal-wrap"><span class="hero-line inline-block">${
        text.split('').map(c => `<span class="hc" style="display:inline-block">${c}</span>`).join('')
      }${accent}</span></span>`;
    nameEl.innerHTML =
      mkLine('ALEJANDRO_') +
      mkLine('VEGA', '<span class="hc" style="display:inline-block;color:var(--accent)">.</span>');
  }
  const heroTerm = document.getElementById('heroTerm');
  if (heroTerm) {
    const lang = getLang();
    const name = D.identity.name.toLowerCase().replace(' ', '_');
    const stackLine1 = `frontend: ${[D.stack.frameworks[2], D.stack.frameworks[4], 'tailwind'].join(' · ').toLowerCase()}`;
    const stackLine2 = `backend: ${[D.stack.languages[0], D.stack.languages[1], D.stack.frameworks[0], D.stack.frameworks[1]].join(' · ').toLowerCase()}`;
    const stackLine3 = `data: ${[D.stack.databases[0], D.stack.databases[2], D.stack.languages[4]].join(' · ').toLowerCase()}`;
    const lines = [
      ['$ whoami', 'ps1'],
      [`${name} — ${D.identity.title[lang].toLowerCase()}`, 'ok'],
      ['$ cat .stack', 'ps1'],
      [stackLine1, ''],
      [stackLine2, ''],
      [stackLine3, ''],
      ['$ status', 'ps1'],
      [`● online · ${D.identity.status[lang].toLowerCase()}`, 'ok'],
      ['$ _', 'ps1'],
    ];
    heroTerm.innerHTML = '';
    let i = 0;
    function nextLine() {
      if (i >= lines.length) return;
      const [text, cls] = lines[i++];
      const div = document.createElement('div');
      if (cls === 'ps1') {
        div.className = 'cy-term-line';
        const ps = document.createElement('span'); ps.className = 'ps1'; ps.textContent = '▸';
        const t = document.createElement('span'); t.textContent = (text as string).replace(/^\$ /,'');
        div.appendChild(ps);
        div.appendChild(t);
      } else {
        div.className = 'cy-term-line' + (cls ? ' ' + cls : ' com');
        div.textContent = text as string;
      }
      heroTerm.appendChild(div);
      setTimeout(nextLine, 220);
    }
    nextLine();
  }
}

// ─── About ───────────────────────────────────────────────────────────────────
function paintAbout() {
  const lang = getLang();
  const el = document.getElementById('aboutTerm');
  if (!el) return;
  el.innerHTML = '';
  const h = document.createElement('div'); h.className = 'cy-term-line';
  h.innerHTML = `<span class="ps1">▸</span><span>cat about.md</span>`; el.appendChild(h);
  const sep = document.createElement('div'); sep.className = 'cy-term-line com';
  sep.textContent = '──────────────────────────────────'; el.appendChild(sep);
  D.about[lang].forEach((line: string) => {
    const p = document.createElement('div'); p.className = 'cy-term-line com';
    p.textContent = line; p.style.marginBottom = '10px'; el.appendChild(p);
  });
  const eof = document.createElement('div'); eof.className = 'cy-term-line com';
  eof.textContent = '[EOF]'; el.appendChild(eof);
}

// ─── Stack ───────────────────────────────────────────────────────────────────
function paintStack() {
  const lang = getLang();
