---
import Layout from '../layouts/Layout.astro';
import TweaksPanel from '../components/TweaksPanel';
import SpotifyNow from '../components/SpotifyNow.astro';
import { portfolioData } from '../lib/data';
import '../styles/global.css';
import fondoImg from '../assets/img/fondo.jpg';
import ingecatImg from '../assets/img/Ingecat.jpg';
import creerImg from '../assets/img/creer.jpg';
import linuxImg from '../assets/img/Linux.jpg';
import vsImg from '../assets/img/VS.jpg';
import gitImg from '../assets/img/GIT.jpg';
import torImg from '../assets/img/TOR.jpg';
import esrbImg from '../assets/img/E.jpg';
import tryImg from '../assets/img/try.jpg';
import duckImg from '../assets/img/duck.jpg';
import { getCollection } from 'astro:content';

const D = portfolioData;

// Blog: últimos posts renderizados en servidor (SEO + visibles sin esperar al JS).
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPosts = allPosts.slice(0, 3);
const fmtPostDate = (d: Date) => d.toLocaleDateString('es-CO', { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' });
const readingTime = (body?: string) => Math.max(1, Math.round((body?.trim().split(/\s+/).length ?? 0) / 200));
// Pila 3D: 4 hojas; si hay menos posts, las de atrás son borradores.
const PAPER_COUNT = 4;
const paperPages = Array.from({ length: PAPER_COUNT }, (_, i) => allPosts[i] ?? null);
const FEATURED_PROJECTS = 6;
const extraProjects = Math.max(0, D.projects.length - FEATURED_PROJECTS);
const topStack = [D.stack.frameworks[0], D.stack.languages[1], D.stack.databases[2]].map(s => s.toUpperCase()).join(' · ');
const companies = D.experience.map(e => e.company.toUpperCase()).join(' · ');
const linkedinHandle = D.identity.contact.linkedin.replace('https://www.linkedin.com', '').replace(/\/$/, '');
const githubHandle = '/' + D.identity.contact.github.split('/').pop();
const tickerItems = [
  { icon: '▲', text: `LOC: ${D.identity.location.en.split(',')[0].toUpperCase()} 04°38'N 74°05'W / ${D.identity.timezone}` },
  ...(latestPosts[0] ? [{ icon: '✎', text: `NUEVO EN EL BLOG: ${latestPosts[0].data.title.toUpperCase()}` }] : []),
  { icon: '●', text: 'RODA / ACTIVO DESDE JUN 2025' },
  { icon: '▼', text: 'KIKI LATAM: +10.000 GUÍAS EN SEGUNDOS · ×10' },
  { icon: '●', text: `STACK: ${topStack}` },
  { icon: '▲', text: 'VEGAREPARACIONES: SEO 100 · A11Y 96 · PERF 90' },
  { icon: '●', text: 'FOR HIRE: REMOTE / HYBRID' },
  { icon: '▼', text: companies },
  { icon: '●', text: 'PULZO: +5 AÑOS DE DATOS CENTRALIZADOS' },
];
---

<Layout title={`${D.identity.name} — Senior Full Stack Developer`}>

<!-- Boot screen -->
<div id="boot" class="cy-boot">
  <div class="text-center font-mono text-[var(--ok)] text-sm leading-relaxed max-w-xl px-6">
    <div id="bootLog" class="text-left"></div>
  </div>
</div>

<!-- Header bar -->
<header style="position:fixed;top:0;left:0;right:0;z-index:40;background:rgba(5,5,7,0.7);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);" data-header>
  <div class="px-6 lg:px-10 h-12 flex items-center text-sm relative">
    <!-- Left: logo -->
    <div class="flex items-center gap-4">
      <span class="font-mono text-[var(--accent)] font-semibold tracking-widest">AV/_</span>
      <span class="font-mono text-[var(--ink-3)] tracking-widest text-[0.7rem] hidden sm:inline">4ledmt.dev</span>
    </div>
    <!-- Center: nav — desktop only -->
    <nav class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-5">
      <a href="#projects" class="font-mono text-[0.74rem] tracking-widest text-[var(--ink-3)] hover:text-[var(--accent)] transition">projects</a>
      <a href="#blog" class="font-mono text-[0.74rem] tracking-widest text-[var(--ink-3)] hover:text-[var(--accent)] transition">blog</a>
      <a href="#exp" class="font-mono text-[0.74rem] tracking-widest text-[var(--ink-3)] hover:text-[var(--accent)] transition">experience</a>
      <a href="/about" class="font-mono text-[0.74rem] tracking-widest text-[var(--ink-3)] hover:text-[var(--accent)] transition">about</a>
    </nav>
    <!-- Right: status + lang + mobile btn -->
    <div class="flex items-center gap-3 ml-auto">
      <span class="cy-status hidden sm:inline-flex"><span class="lang-es">disponible</span><span class="lang-en">available</span></span>
      <button id="langToggle" class="font-mono text-[0.78rem] tracking-widest border border-[var(--line-2)] px-2 py-1 hover:border-[var(--accent)] hover:text-[var(--accent)] transition">
        <span class="lang-es">EN</span><span class="lang-en">ES</span>
      </button>
      <button id="mobileMenuBtn" class="md:hidden w-8 h-8 flex items-center justify-center border border-[var(--line-2)] font-mono text-base text-[var(--ink-3)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition" aria-label="menu">≡</button>
    </div>
  </div>
  <!-- Mobile menu dropdown -->
  <nav id="mobileMenu" class="hidden md:hidden border-t border-[var(--line)] px-6 py-5" style="background:rgba(5,5,7,0.97);">
    <div class="flex flex-col gap-4">
      <a href="#projects" class="mob-link font-mono text-sm tracking-widest text-[var(--ink-2)] hover:text-[var(--accent)] transition flex items-center gap-2"><span class="text-[var(--accent)] text-xs">▸</span>projects</a>
      <a href="#blog" class="mob-link font-mono text-sm tracking-widest text-[var(--ink-2)] hover:text-[var(--accent)] transition flex items-center gap-2"><span class="text-[var(--accent)] text-xs">▸</span>blog</a>
      <a href="#exp" class="mob-link font-mono text-sm tracking-widest text-[var(--ink-2)] hover:text-[var(--accent)] transition flex items-center gap-2"><span class="text-[var(--accent)] text-xs">▸</span>experience</a>
      <a href="#stack" class="mob-link font-mono text-sm tracking-widest text-[var(--ink-2)] hover:text-[var(--accent)] transition flex items-center gap-2"><span class="text-[var(--accent)] text-xs">▸</span>stack</a>
      <a href="#contact" class="mob-link font-mono text-sm tracking-widest text-[var(--ink-2)] hover:text-[var(--accent)] transition flex items-center gap-2"><span class="text-[var(--accent)] text-xs">▸</span>contact</a>
      <div class="border-t border-[var(--line)] pt-4 flex gap-4">
        <a href="/blog" class="font-mono text-xs tracking-widest text-[var(--ink-3)] hover:text-[var(--accent)] transition">todos los posts ↗</a>
        <a href="/about" class="font-mono text-xs tracking-widest text-[var(--ink-3)] hover:text-[var(--accent)] transition">about ↗</a>
      </div>
    </div>
  </nav>
  <!-- Ticker -->
  <div style="display:flex;align-items:center;height:30px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;background:var(--bg-2);position:relative;max-width:100vw;">
    <div class="cy-marquee" data-marquee="80">
      <div class="flex items-center">
        {tickerItems.map(item => (
          <span class="font-mono text-[0.74rem] tracking-[0.1em] text-[var(--ink-2)] px-[18px] inline-flex items-center gap-[10px]">
            <span class="text-[var(--accent)]">{item.icon}</span> {item.text}
          </span>
        ))}
      </div>
    </div>
  </div>
</header>


<main class="pt-[100px] overflow-x-hidden">

<!-- HERO -->
<section id="hero" class="relative min-h-[calc(100svh-100px)] cy-scanlines flex items-center px-6 lg:px-20 overflow-hidden max-w-full" style="background:radial-gradient(1200px 600px at 80% -10%,rgba(255,0,60,0.18),transparent 60%),radial-gradient(900px 500px at 0% 110%,rgba(255,0,60,0.10),transparent 60%),var(--bg);">
  <img
    id="heroBg"
    src={fondoImg.src}
    alt=""
    aria-hidden="true"
    class="absolute right-0 top-0 h-[110%] w-auto pointer-events-none select-none"
    style="opacity:0;mix-blend-mode:lighten;filter:saturate(1.4) brightness(0.9);transform-origin:center top;object-fit:cover;"
  />
  <div class="cy-grid absolute inset-0 pointer-events-none"></div>
  <div class="hero-grid grid lg:grid-cols-12 gap-10 w-full max-w-[1480px] mx-auto items-end relative z-10">
    <div class="lg:col-span-7">
      <div class="flex items-center gap-3 mb-8">
        <span class="cy-eyebrow">// SENIOR FULL STACK DEVELOPER</span>
        <span class="h-px w-10 bg-[var(--accent)]"></span>
        <span class="font-mono text-[0.72rem] text-[var(--ink-3)] tracking-widest">v.2026</span>
      </div>
      <h1 
        class="font-mono font-extrabold tracking-[-0.06em] leading-[0.82] whitespace-nowrap"
        style="font-size:clamp(3rem,9vw,9rem);"
        id="heroName">
      </h1>
      <p class="mt-8 max-w-xl text-[var(--ink-2)] text-lg leading-relaxed font-display">
        <span class="lang-es">{D.identity.tagline.es}</span>
        <span class="lang-en">{D.identity.tagline.en}</span>
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#contact" class="cy-btn solid" data-magnetic>
          <span class="lang-es">HABLEMOS ↗</span>
          <span class="lang-en">LET'S TALK ↗</span>
        </a>
        <a href="#blog" class="cy-btn">
          <span class="lang-es">LEER EL BLOG</span>
          <span class="lang-en">READ THE BLOG</span>
        </a>
      </div>
      <div class="mt-12 lg:mt-16 grid grid-cols-3 gap-3 sm:gap-6 max-w-xl">
        {D.highlights.map(h => (
          <div style="border-top:1px solid var(--line);padding-top:14px;">
            <div class="font-display text-[2.4rem] font-bold leading-none" data-counter={h.value} data-counter-prefix={h.prefix} data-counter-suffix={h.suffix}>0</div>
            <div class="font-mono text-[0.7rem] text-[var(--ink-3)] tracking-[0.15em] uppercase mt-[6px] leading-tight">
              <span class="lang-es">{h.label.es}</span><span class="lang-en">{h.label.en}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hidden lg:block lg:col-span-5 relative">
      <div class="relative border border-[var(--line)] bg-[var(--panel)] overflow-hidden">
        <span style="position:absolute;top:-1px;left:-1px;width:18px;height:18px;border:1px solid var(--accent);border-right:0;border-bottom:0;"></span>
        <span style="position:absolute;top:-1px;right:-1px;width:18px;height:18px;border:1px solid var(--accent);border-left:0;border-bottom:0;"></span>
        <span style="position:absolute;bottom:-1px;left:-1px;width:18px;height:18px;border:1px solid var(--accent);border-right:0;border-top:0;"></span>
        <span style="position:absolute;bottom:-1px;right:-1px;width:18px;height:18px;border:1px solid var(--accent);border-left:0;border-top:0;"></span>
        <div class="cy-term-bar">
          <span class="dot r"></span><span class="dot"></span><span class="dot"></span>
          <span>~/alejandro@4ledmt</span>
          <span class="label">tty/01</span>
        </div>
        <div class="cy-term-body min-h-[280px]" id="heroTerm"></div>
      </div>
      <div class="absolute -top-6 -right-6 w-24 h-24 border border-[var(--accent)] flex items-center justify-center font-mono text-xs text-[var(--accent)] tracking-widest rotate-12">
        <div class="text-center leading-tight">BOGOTÁ<br/>·<br/>04°N</div>
      </div>
    </div>
  </div>

  <pre class="font-mono font-bold opacity-[0.05] absolute -right-10 bottom-0 select-none pointer-events-none text-[10px] sm:text-xs hidden md:block" style="white-space:pre;line-height:0.98;color:var(--accent);">
█████╗  ██╗   ██╗
██╔══██╗ ██║   ██║
███████║ ██║   ██║
██╔══██║ ╚██╗ ██╔╝
██║  ██║  ╚████╔╝
╚═╝  ╚═╝   ╚═══╝</pre>
</section>

<!-- NOW STATUS BAND -->
<div id="nowBand" class="border-y border-[var(--line)] overflow-hidden bg-[var(--bg-2)] relative">
  <div class="flex items-stretch overflow-x-auto no-scrollbar" style="max-width:100vw;">
    <div class="now-item">
      <span style="flex-shrink:0;width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 8px var(--ok);animation:pulse 1.6s ease-in-out infinite;display:inline-block;"></span>
      <span class="lang-es">DISPONIBLE — REMOTO/HÍBRIDO</span>
      <span class="lang-en">AVAILABLE — REMOTE/HYBRID</span>
    </div>
    <div class="now-item" style="flex:1;" id="nowTrackItem">
      <span style="color:var(--accent);" id="nowPlayIcon">♪</span>
      <span id="nowTrackText" style="font-family:var(--font-mono);font-size:0.74rem;letter-spacing:0.08em;">···</span>
    </div>
    <div class="now-item">
      <span style="color:var(--ink-3);">BOGOTÁ</span>
      <span style="color:var(--accent);" id="nowClock">--:--:--</span>
    </div>
    <div class="now-item hidden lg:flex">
      <span style="color:var(--ink-3);">RODA</span>
      <span style="color:var(--ok);"><span class="lang-es">ACTIVO DESDE JUN 2025</span><span class="lang-en">ACTIVE SINCE JUN 2025</span></span>
    </div>
  </div>
</div>

<!-- ABOUT -->
<section id="about" class="relative px-6 lg:px-20 py-20 lg:py-28 overflow-hidden">
  <!-- Decorative bg number -->
  <div class="absolute -right-4 top-1/2 -translate-y-1/2 font-display font-bold leading-none select-none pointer-events-none hidden lg:block" style="font-size:clamp(14rem,22vw,22rem);color:var(--line);opacity:0.45;letter-spacing:-0.04em;" aria-hidden="true">01</div>

  <div class="max-w-[1480px] mx-auto grid lg:grid-cols-12 gap-10 lg:gap-16">
    <!-- Left sticky col -->
    <div class="lg:col-span-4 lg:sticky lg:top-28 self-start">
      <!-- Availability badge -->
      <div class="flex items-center gap-2 font-mono text-xs mb-5">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--ok)]" style="box-shadow:0 0 6px var(--ok)"></span>
        <span class="text-[var(--ok)]"><span class="lang-es">Disponible ahora</span><span class="lang-en">Available now</span></span>
        <span class="text-[var(--line-2)]">·</span>
        <span class="text-[var(--ink-3)]">Bogotá · GMT-5</span>
      </div>

      <div class="cy-eyebrow mb-4" data-scramble><span class="lang-es">// 01 _ SOBRE_MÍ</span><span class="lang-en">// 01 _ ABOUT_ME</span></div>
      <h2 class="cy-headline text-5xl lg:text-6xl" data-reveal="up">
        <span class="lang-es">Full stack con<br/><span class="text-[var(--accent)]">foco</span><br/>operativo.</span>
        <span class="lang-en">Full stack with<br/><span class="text-[var(--accent)]">operational</span><br/>focus.</span>
      </h2>

      <!-- Thin rule with year count -->
      <div class="mt-8 mb-8 flex items-center gap-3">
        <span class="block flex-1 h-px bg-[var(--line)]"></span>
        <span class="font-mono text-xs text-[var(--ink-3)]">4 YRS</span>
        <span class="block w-1.5 h-1.5 bg-[var(--accent)]"></span>
      </div>

      <!-- Ingecat dev card -->
      <div id="ingecatCard" style="position:relative;transform-style:preserve-3d;will-change:transform;max-width:72%;">
        <span class="ing-c" style="position:absolute;top:-1px;left:-1px;width:14px;height:14px;border:1px solid var(--accent);border-right:0;border-bottom:0;z-index:4;pointer-events:none;"></span>
        <span class="ing-c" style="position:absolute;top:-1px;right:-1px;width:14px;height:14px;border:1px solid var(--accent);border-left:0;border-bottom:0;z-index:4;pointer-events:none;"></span>
        <span class="ing-c" style="position:absolute;bottom:-1px;left:-1px;width:14px;height:14px;border:1px solid var(--accent);border-right:0;border-top:0;z-index:4;pointer-events:none;"></span>
        <span class="ing-c" style="position:absolute;bottom:-1px;right:-1px;width:14px;height:14px;border:1px solid var(--accent);border-left:0;border-top:0;z-index:4;pointer-events:none;"></span>
        <div id="ingecatInner" class="border border-[var(--line)] overflow-hidden" style="background:var(--panel);position:relative;">
          <img id="ingecatImg" src={ingecatImg.src} alt="" style="display:block;width:100%;height:auto;" />
          <div id="ingecatScan" style="position:absolute;left:0;right:0;height:35%;pointer-events:none;z-index:3;background:linear-gradient(to bottom,transparent,rgba(255,255,255,0.07) 50%,transparent);top:-35%;opacity:0;"></div>
          <div style="position:absolute;inset:0;pointer-events:none;z-index:2;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.14) 2px,rgba(0,0,0,0.14) 3px);"></div>
        </div>
      </div>
      <!-- Caption -->
      <div class="mt-3 font-mono text-xs text-[var(--ink-3)]" style="max-width:72%;">
        <span class="text-[var(--accent)]">~/</span> ingecatdev
        <span class="text-[var(--line-2)] mx-1.5">·</span>
        <span class="lang-es">alias de trabajo</span><span class="lang-en">work alias</span>
      </div>
    </div>

    <!-- Right col -->
    <div class="lg:col-span-7 lg:col-start-6">
      <div class="cy-term">
        <div class="cy-term-bar">
          <span class="dot r"></span><span class="dot"></span><span class="dot"></span>
          <span>cat about.md</span><span class="label">utf-8</span>
        </div>
        <div class="cy-term-body space-y-4 text-base" id="aboutTerm"></div>
      </div>

      <!-- Redesigned stat cards -->
      <div class="grid grid-cols-2 gap-3 mt-10" data-stagger>
        <div class="about-stat" data-stagger-item>
          <div class="about-stat-num">01</div>
          <div class="about-stat-key">// FOCUS</div>
          <div class="about-stat-val">Full Stack</div>
          <div class="about-stat-sub">React · Angular · APIs</div>
        </div>
        <div class="about-stat" data-stagger-item>
          <div class="about-stat-num">02</div>
          <div class="about-stat-key">// METHOD</div>
          <div class="about-stat-val"><span class="lang-es">Ops + datos</span><span class="lang-en">Ops + data</span></div>
          <div class="about-stat-sub">Automatización · SQL · BQ</div>
        </div>
        <div class="about-stat" data-stagger-item>
          <div class="about-stat-num">03</div>
          <div class="about-stat-key">// ROOTS</div>
          <div class="about-stat-val">{D.identity.educationShort.es}</div>
          <div class="about-stat-sub"><span class="lang-es">{D.identity.educationSub.es}</span><span class="lang-en">{D.identity.educationSub.en}</span></div>
        </div>
        <div class="about-stat" data-stagger-item>
          <div class="about-stat-num">04</div>
          <div class="about-stat-key">// MODE</div>
          <div class="about-stat-val"><span class="lang-es">Remoto / Híbrido</span><span class="lang-en">Remote / Hybrid</span></div>
          <div class="about-stat-sub"><span class="lang-es">incorporación inmediata</span><span class="lang-en">immediate start</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- STACK -->
<section id="stack" class="relative px-6 lg:px-20 py-20 lg:py-28 border-y border-[var(--line)] bg-[var(--bg-2)] cy-scanlines overflow-hidden">
  <div class="max-w-[1480px] mx-auto">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12">
      <div>
        <div class="cy-eyebrow mb-3" data-scramble>// 02 _ STACK</div>
        <h2 class="cy-headline text-5xl lg:text-7xl" data-reveal="up">
          <span class="lang-es">Las herramientas<br/>que <span class="text-[var(--accent)]">domino</span>.</span>
          <span class="lang-en">The tools<br/>I <span class="text-[var(--accent)]">master</span>.</span>
        </h2>
      </div>
      <p class="font-mono text-sm text-[var(--ink-3)] max-w-sm">
        <span class="lang-es">Sin religiones tecnológicas. Elijo la herramienta correcta para el problema correcto.</span>
        <span class="lang-en">No tech religions. The right tool for the right problem.</span>
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4" id="stackGrid" data-stagger></div>

    <div class="mt-14 border border-[var(--line)] p-6 lg:p-8" style="background:linear-gradient(135deg,var(--panel),transparent);">
      <div class="cy-num mb-4">// <span class="lang-es">{D.automation.title.es.toUpperCase()}</span><span class="lang-en">{D.automation.title.en.toUpperCase()}</span></div>
      <ul class="grid md:grid-cols-3 gap-6" data-stagger>
        {D.automation.items.es.map((_, i) => (
          <li data-stagger-item style="display:flex;flex-direction:column;gap:8px;">
            <span class="font-mono text-[0.7rem] tracking-[0.18em] text-[var(--accent)]">{String(i + 1).padStart(2, '0')} //</span>
            <span class="text-[var(--ink-2)] leading-relaxed text-[0.95rem]">
              <span class="lang-es">{D.automation.items.es[i]}</span>
              <span class="lang-en">{D.automation.items.en[i]}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>


<!-- PROJECTS -->
<section id="projects" class="relative px-6 lg:px-20 py-20 lg:py-28 border-y border-[var(--line)]">
  <div class="max-w-[1480px] mx-auto">
    <div class="cy-eyebrow mb-4" data-scramble>
      <span class="lang-es">// 03 _ PROYECTOS</span>
      <span class="lang-en">// 03 _ PROJECTS</span>
    </div>
    <h2 class="cy-headline text-5xl lg:text-7xl mb-12" data-reveal="up">
      <span class="lang-es">Casos que <span class="text-[var(--accent)]">construí</span>.</span>
      <span class="lang-en">Cases I <span class="text-[var(--accent)]">built</span>.</span>
    </h2>
    <div class="grid sm:grid-cols-2 gap-4 lg:gap-6" id="projectsGrid" data-stagger></div>
    {extraProjects > 0 && (
      <div class="mt-10 flex justify-center">
        <button type="button" id="projectsToggle" class="cy-btn" aria-expanded="false" aria-controls="projectsGrid" data-extra={extraProjects}>
          <span class="lang-es" data-label-es>VER {extraProjects} PROYECTOS MÁS ↓</span>
