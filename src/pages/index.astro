      { key: lang === 'en' ? 'tools' : 'herramientas', items: D.stack.tools },
    ];
    grid.innerHTML = groups.map((g) => `
      <div style="border:1px solid var(--line);padding:18px 16px;display:flex;flex-direction:column;gap:8px;background:linear-gradient(135deg,var(--panel),transparent);will-change:transform;" class="stack-cell" data-stagger-item>
        <div style="font-family:var(--font-mono);font-size:0.66rem;letter-spacing:0.18em;color:var(--ink-3);text-transform:uppercase;">// ${g.key}</div>
        <ul style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">${g.items.map((i) => `<li style="font-family:var(--font-mono);font-size:0.78rem;color:var(--ink);border:1px solid var(--line-2);padding:3px 8px;">${i}</li>`).join('')}</ul>
      </div>
    `).join('');
  }
}


// ─── Experience ───────────────────────────────────────────────────────────────
function paintExp() {
  const lang = getLang();
  const el = document.getElementById('expList');
  if (!el) return;
  el.innerHTML = D.experience.map((x: any, i: number) => `
    <div class="exp-row">
      <div style="font-family:var(--font-mono);color:var(--accent);font-size:0.78rem;letter-spacing:0.1em;">$ role_${String(D.experience.length - i).padStart(2,'0')}<br/><span style="color:var(--ink-3);">${x.period[lang]}</span></div>
      <div>
        <div style="font-family:var(--font-display);font-size:1.6rem;font-weight:600;">${x.company}</div>
