// ─── i18n ───────────────────────────────────────────────────────────────────
const LANG_KEY = 'av_lang';
const getLang = (): 'es' | 'en' => (localStorage.getItem(LANG_KEY) as 'es' | 'en') || 'es';
const setLang = (lang: 'es' | 'en') => {
  localStorage.setItem(LANG_KEY, lang);
  document.documentElement.setAttribute('data-lang', lang);
};
document.documentElement.setAttribute('data-lang', getLang());

// ─── Cursor ─────────────────────────────────────────────────────────────────
function initCursor() {
  if (document.documentElement.hasAttribute('data-tweak-nocursor')) return;
  const cursor = document.createElement('div');
  cursor.className = 'cy-cursor';
  document.body.appendChild(cursor);
  let tx = 0, ty = 0, x = 0, y = 0;
  window.addEventListener('mousemove', (e) => { tx = e.clientX; ty = e.clientY; });
  gsap.ticker.add(() => {
    x += (tx - x) * 0.22;
    y += (ty - y) * 0.22;
    cursor.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
  });
  document.addEventListener('mouseover', (e) => {
    const t = e.target as Element;
    if (t?.closest?.('a, button, .cy-btn, .cy-tile, [data-cursor]')) cursor.classList.add('hover');
  });
  document.addEventListener('mouseout', (e) => {
    const t = e.target as Element;
    if (t?.closest?.('a, button, .cy-btn, .cy-tile, [data-cursor]')) cursor.classList.remove('hover');
  });
}

// ─── Text scramble ──────────────────────────────────────────────────────────
const SCRAMBLE_CHARS = '!<>-_\\/[]{}—=+*^?#________ABCDEF0123456789';
function scramble(el: HTMLElement, finalText: string) {
  const finalArr = finalText.split('');
  let frame = 0;
  const queue = finalArr.map((c, i) => ({
    to: c, from: (el as any)._prev ? ((el as any)._prev[i] || '') : '',
    start: Math.floor(Math.random() * 18), end: Math.floor(Math.random() * 30) + 18,
  }));
  let raf: number;
  function update() {
    let out = '', complete = 0;
    for (const { to, start, end } of queue) {
      if (frame >= end) { complete++; out += to; }
      else if (frame >= start) out += SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
      else out += ' ';
    }
    el.textContent = out;
    if (complete === queue.length) { (el as any)._prev = finalText; return; }
    frame++;
    raf = requestAnimationFrame(update);
  }
  cancelAnimationFrame(raf!);
  update();
}

function initScramble() {
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const txt = el.textContent || '';
    (el as any)._scrambleText = txt;
    el.textContent = '';
    ScrollTrigger.create({ trigger: el, start: 'top 85%', once: true, onEnter: () => scramble(el, (el as any)._scrambleText) });
  });
}

// ─── Marquee ────────────────────────────────────────────────────────────────
function initMarquees() {
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => {
    const speed = parseFloat(el.dataset.marquee || '60');
    const inner = el.firstElementChild as HTMLElement;
    if (!inner) return;
    const dup = inner.cloneNode(true) as HTMLElement;
    dup.setAttribute('aria-hidden', 'true');
    el.appendChild(dup);
    const w = inner.getBoundingClientRect().width;
    gsap.to(Array.from(el.children), { x: -w, duration: w / speed, ease: 'none', repeat: -1 });
  });
}

// ─── Reveals — horizontal blur wipe ────────────────────────────────────────
function initReveals() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;

  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
    gsap.fromTo(el,
      { clipPath: 'inset(0 100% 0 0)', filter: 'blur(16px)', x: -24 },
      { clipPath: 'inset(0 0% 0 0)', filter: 'blur(0px)', x: 0,
        duration: 1.35, ease: 'expo.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true } }
    );
  });

  // Stagger groups — scale + blur fade
  document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((g) => {
    const items = g.querySelectorAll('[data-stagger-item]');
    gsap.fromTo(items,
      { y: 60, opacity: 0, scale: 0.92, filter: 'blur(6px)' },
      { y: 0, opacity: 1, scale: 1, filter: 'blur(0px)',
        duration: 0.9, stagger: 0.09, ease: 'expo.out',
        scrollTrigger: { trigger: g, start: 'top 82%', once: true } }
    );
  });
}

