        ${x.note ? `<div style="font-family:var(--font-mono);font-size:0.72rem;color:var(--ink-3);margin-top:4px;">${x.note[lang]}</div>` : ''}
      </div>
      <div>
        <ul style="display:flex;flex-direction:column;gap:8px;color:var(--ink-2);line-height:1.55;">
          ${x.bullets[lang].map((b: string) => `<li style="display:flex;gap:10px;"><span style="color:var(--accent);flex-shrink:0;">▸</span><span>${b}</span></li>`).join('')}
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;">${x.stack.map((s: string) => `<span class="cy-tag">${s}</span>`).join('')}</div>
      </div>
