    projects: (_, l) => l === 'en'
      ? ['[001] CUFE/DIAN automation — Python · BigQuery','[002] Shipping platform   — NestJS · PostgreSQL','[003] Laravel task manager — Laravel · Livewire','[004] GA4+BigQuery reporting — SQL · Looker Studio']
      : ['[001] Automatización CUFE/DIAN — Python · BigQuery','[002] Sistema de envíos      — NestJS · PostgreSQL','[003] Gestor de tareas Laravel — Laravel · Livewire','[004] Reportería GA4+BigQuery  — SQL · Looker Studio'],
