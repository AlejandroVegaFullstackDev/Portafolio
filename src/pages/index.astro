  tick();
  setInterval(tick, 1000);
}

// ─── Now band entrance animation ──────────────────────────────────────────────
function initNowBand() {
  gsap.from('#nowBand .now-item', {
    x: 30, opacity: 0, duration: 0.55, stagger: 0.1, ease: 'expo.out', delay: 1.5,
  });
}

// ─── Cursor trail ─────────────────────────────────────────────────────────────
function initCursorTrail() {
  if (window.matchMedia('(hover: none)').matches) return;
  if (document.documentElement.hasAttribute('data-tweak-nocursor')) return;
  const TRAIL = 6;
  const dots: HTMLElement[] = [];
  const pos: {x:number,y:number}[] = [];
  for (let i = 0; i < TRAIL; i++) {
    const d = document.createElement('div');
    d.className = 'cy-trail';
    d.style.opacity = String(0.5 - i * 0.07);
    d.style.transform = `translate(-50%,-50%) scale(${1 - i * 0.12})`;
    document.body.appendChild(d);
    dots.push(d);
    pos.push({ x: 0, y: 0 });
  }
  let mx = 0, my = 0;
  window.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
  gsap.ticker.add(() => {
    pos[0].x += (mx - pos[0].x) * 0.35;
    pos[0].y += (my - pos[0].y) * 0.35;
    for (let i = 1; i < TRAIL; i++) {
      pos[i].x += (pos[i-1].x - pos[i].x) * 0.45;
      pos[i].y += (pos[i-1].y - pos[i].y) * 0.45;
    }
    dots.forEach((d, i) => { d.style.transform = `translate(${pos[i].x}px,${pos[i].y}px) translate(-50%,-50%)`; });
  });
}

// ─── Hero parallax ────────────────────────────────────────────────────────────
function initHeroPin() {
  if (document.documentElement.getAttribute('data-tweak-anim') !== 'high') return;
  const name = document.getElementById('heroName');
  if (!name) return;
  gsap.to(name, { yPercent: -15, ease: 'none', scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true } });
}

// ─── Image animations ─────────────────────────────────────────────────────────
function initImageAnimations() {
  // Hero background: fade in + scale down + scroll parallax
  const heroBg = document.getElementById('heroBg');
  if (heroBg) {
    const bgOpacity = window.matchMedia('(max-width: 767px)').matches ? 0.22 : 0.2;
    gsap.fromTo(heroBg,
      { scale: 1.08, opacity: 0 },
      { scale: 1, opacity: bgOpacity, duration: 2.4, ease: 'power2.out', delay: 1.2 }
    );
    gsap.to(heroBg, {
      yPercent: -15,
      ease: 'none',
      scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 1.5 }
    });
  }

  // Ingecat: CRT power-on + glitch burst + scanline + periodic glitch + chromatic hover
  const ingecat = document.getElementById('ingecatCard');
  const ingecatScan = document.getElementById('ingecatScan');
  const ingecatCorners = ingecat ? Array.from(ingecat.querySelectorAll<HTMLElement>('.ing-c')) : [];
  if (ingecat) {
    let isHovering = false;

    // ── Scanline sweep ──────────────────────────────────────────────────────
    function sweepScan() {
      if (!ingecatScan) return;
      gsap.fromTo(ingecatScan,
        { top: '-35%', opacity: 0 },
        { top: '125%', opacity: 1, duration: 1.9, ease: 'power1.inOut',
          onComplete: () => { gsap.set(ingecatScan, { opacity: 0 }); setTimeout(sweepScan, 4500 + Math.random() * 3000); } }
      );
    }

    // ── Periodic glitch ──────────────────────────────────────────────────────
    function doGlitch() {
      const delay = 3200 + Math.random() * 5000;
      setTimeout(() => {
        if (!isHovering) {
          const dramatic = Math.random() > 0.65;
          const tl = gsap.timeline({ onComplete: doGlitch });
          tl.to(ingecat, { x: dramatic ? -16 : -8, duration: 0.04, ease: 'none' })
            .to(ingecat, { x: dramatic ? 12 : 5, skewX: dramatic ? 3 : 1, duration: 0.04, ease: 'none' })
            .to(ingecat, { x: dramatic ? -7 : 0, skewX: 0, duration: 0.04, ease: 'none' });
          if (dramatic) {
            tl.to(ingecat, { x: 4, duration: 0.03, ease: 'none' });
          }
          tl.to(ingecat, { x: 0, duration: 0.12, ease: 'power2.out' });
        } else {
          doGlitch();
        }
      }, delay);
    }

    // ── Entrance ─────────────────────────────────────────────────────────────
    gsap.set(ingecat, { scaleY: 0.02, opacity: 1, transformPerspective: 900, transformOrigin: 'center center' });
    gsap.set(ingecatCorners, { opacity: 0 });

    ScrollTrigger.create({
      trigger: ingecat, start: 'top 88%', once: true,
      onEnter: () => {
        const tl = gsap.timeline();

        // CRT expand + brightness spike
        tl.to(ingecat, { scaleY: 1.07, duration: 0.3, ease: 'power3.out' })
          .to(ingecat, { scaleY: 0.97, duration: 0.1, ease: 'power2.inOut' })
          .to(ingecat, { scaleY: 1, duration: 0.18, ease: 'power2.out' })
          .set(ingecat, { filter: 'brightness(3.5)' }, '<-0.3')
          .to(ingecat, { filter: 'brightness(1)', duration: 0.55, ease: 'power2.out' }, '<')

        // Glitch burst
          .to(ingecat, { x: -18, duration: 0.04, ease: 'none' }, '<0.05')
          .to(ingecat, { x: 13, duration: 0.04, ease: 'none' })
          .set(ingecat, { filter: 'hue-rotate(110deg) brightness(1.6)' })
          .to(ingecat, { x: -8, duration: 0.04, ease: 'none' })
          .set(ingecat, { filter: 'hue-rotate(0deg) brightness(1)' })
          .to(ingecat, { x: 4, duration: 0.04, ease: 'none' })
          .to(ingecat, { x: 0, duration: 0.18, ease: 'power2.out' })

        // Corner accents flash in
          .to(ingecatCorners, { opacity: 1, duration: 0.04, stagger: 0.04, ease: 'none' }, '<-0.1')

        // Settle: float + start periodic effects
          .call(() => {
            gsap.to(ingecat, { y: -8, duration: 3.4, ease: 'sine.inOut', repeat: -1, yoyo: true });
            doGlitch();
            setTimeout(sweepScan, 1800);
          });
      },
    });

    // ── Hover: chromatic 3D tilt ───────────────────────────────────────────
    ingecat.addEventListener('mouseenter', () => {
      isHovering = true;
      gsap.timeline()
        .to(ingecat, { x: -5, duration: 0.04, ease: 'none' })
        .to(ingecat, { x: 0, duration: 0.12, ease: 'power2.out' });
    });

    ingecat.addEventListener('mousemove', (e: MouseEvent) => {
      const r = ingecat.getBoundingClientRect();
      const nx = ((e.clientX - r.left) / r.width  - 0.5) * 2;
      const ny = ((e.clientY - r.top)  / r.height - 0.5) * 2;
      const gx = (-nx * 18).toFixed(1);
      const gy = (ny  * 10).toFixed(1);
      gsap.to(ingecat, {
        rotateY: nx * 24, rotateX: -ny * 18, scale: 1.05,
        filter: `drop-shadow(${gx}px ${gy}px 22px rgba(255,0,60,0.5)) drop-shadow(${-Number(gx)*0.4}px ${-Number(gy)*0.4}px 14px rgba(0,120,255,0.35))`,
        transformPerspective: 700, duration: 0.35, ease: 'power3.out', overwrite: 'auto',
      });
    });

    ingecat.addEventListener('mouseleave', () => {
      isHovering = false;
      gsap.to(ingecat, {
        rotateY: 0, rotateX: 0, scale: 1, filter: 'none',
        duration: 0.9, ease: 'elastic.out(1, 0.4)', overwrite: 'auto',
      });
    });
  }

  // Sticker cluster: staggered bounce-in + independent idle floats + spring hover
  const stickers = Array.from(document.querySelectorAll<HTMLElement>('#stickerCluster .stk'));
  if (stickers.length) {
    stickers.forEach((stk) => {
      const rot = parseFloat(stk.dataset.rot || '0');
      gsap.set(stk, { opacity: 0, scale: 0, rotation: rot + gsap.utils.random(-25, 25) as number });
    });

    ScrollTrigger.create({
      trigger: '#contact', start: 'top 78%', once: true,
      onEnter: () => {
        stickers.forEach((stk, i) => {
          const rot = parseFloat(stk.dataset.rot || '0');
          gsap.to(stk, {
            opacity: 1, scale: 1, rotation: rot,
            duration: 0.7, ease: 'back.out(2.4)',
            delay: 0.07 * i,
            onComplete() {
              // Each sticker floats independently
              gsap.to(stk, {
                y: -gsap.utils.random(4, 9) as number,
                rotation: rot + (gsap.utils.random(-2.5, 2.5) as number),
                duration: gsap.utils.random(2.6, 4.1) as number,
                ease: 'sine.inOut', repeat: -1, yoyo: true,
              });
            },
          });
        });
      },
    });

    stickers.forEach((stk) => {
      const rot = parseFloat(stk.dataset.rot || '0');
      const popRot = rot + (Math.random() > 0.5 ? 10 : -10);

      const stkImg = stk.querySelector('img') as HTMLElement;
      stk.addEventListener('mouseenter', () => {
        gsap.to(stk, {
          scale: 1.22, rotation: popRot, zIndex: 10,
          duration: 0.22, ease: 'power2.out', overwrite: 'auto',
        });
        gsap.to(stkImg, {
          filter: 'drop-shadow(4px 8px 20px rgba(0,0,0,0.8)) drop-shadow(0 0 12px rgba(255,0,60,0.3))',
          duration: 0.22, ease: 'power2.out', overwrite: 'auto',
        });
      });

      stk.addEventListener('mouseleave', () => {
        gsap.to(stk, {
          scale: 1, rotation: rot, zIndex: 1,
          duration: 0.65, ease: 'elastic.out(1, 0.38)', overwrite: 'auto',
        });
        gsap.to(stkImg, {
          filter: 'drop-shadow(2px 4px 12px rgba(0,0,0,0.65))',
          duration: 0.65, ease: 'elastic.out(1, 0.38)', overwrite: 'auto',
        });
      });
    });
  }

}

// ─── Spotify now playing ──────────────────────────────────────────────────────
function initNowPlaying() {
  const icon = document.getElementById('nowPlayIcon');
  const text = document.getElementById('nowTrackText');

  async function fetchNow() {
    try {
      const res = await fetch('/api/now-playing');
      if (!res.ok) return;
      const data = await res.json();

      // Update now-band
      if (icon && text) {
        if (data.isPlaying && data.title && data.artist) {
          text.textContent = `${data.artist.toUpperCase()} — ${data.title.toUpperCase()}`;
          icon.textContent = '♫';
        } else {
          text.textContent = 'KAVINSKY — NIGHTCALL';
          icon.textContent = '▶';
        }
      }

      // Drive the SpotifyNow widget
      window.dispatchEvent(new CustomEvent('spotify:update', { detail: data }));
    } catch {
      // keep defaults
    }
  }

  fetchNow();
  setInterval(fetchNow, 30_000);
}

// ─── Main ─────────────────────────────────────────────────────────────────────
async function start() {
  await bootSequence();
  paintHero();
  paintAbout();
  paintStack();
  paintExp();
  paintProjects();
  // GSAP animations
  initCursor();
  initScramble();
  initMarquees();
  initReveals();
  initMagnetic();
  initCounters();
  initHeroPin();
  initExpAnimations();
  initEyebrows();
  initSpotlight();
  initCursorTrail();
  init3DTiles();
  initHeroGlitch();
  initCharReveal();
  initWaveHero();
  initNowClock();
  initNowBand();
  initImageAnimations();
  initNowPlaying();

  // Hero name char-by-char reveal — more dramatic stagger
  gsap.from('#heroName .hc', { yPercent: 120, rotateX: -40, duration: 0.9, ease: 'expo.out', stagger: 0.025, delay: 0.1 });
  gsap.from('#hero p', { y: 30, opacity: 0, duration: 0.9, ease: 'expo.out', delay: 0.7 });
  gsap.from('#hero .cy-btn', { y: 24, opacity: 0, scale: 0.9, duration: 0.7, stagger: 0.12, ease: 'expo.out', delay: 0.9 });
  gsap.from('#hero .grid > div', { y: 40, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'expo.out', delay: 1.1 });

  // Lang toggle
  const langBtn = document.getElementById('langToggle');
  if (langBtn) {
    langBtn.addEventListener('click', () => {
      setLang(getLang() === 'es' ? 'en' : 'es');
      paintAbout(); paintStack(); paintExp(); paintProjects();
      init3DTiles();
      // Rebuild hero term and game with new lang
      const heroTerm = document.getElementById('heroTerm');
      if (heroTerm) { heroTerm.innerHTML = ''; paintHero(); }
      const tg = document.getElementById('termGame');
      if (tg) { tg.innerHTML = ''; attachTerminalGame(tg, getLang()); }
    });
  }

  // Terminal game
  const tg = document.getElementById('termGame');
  if (tg) attachTerminalGame(tg, getLang());

  setTimeout(() => ScrollTrigger.refresh(), 200);
}

start();
</script>
