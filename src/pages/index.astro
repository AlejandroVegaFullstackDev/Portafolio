      <p style="font-family:var(--font-mono);font-size:0.75rem;color:var(--accent);margin-bottom:1rem;letter-spacing:0.06em;">${p.kicker[lang]}</p>
      <p style="color:var(--ink-2);font-size:0.875rem;line-height:1.6;margin-bottom:1.25rem;">${p.summary[lang].slice(0,140)}${p.summary[lang].length>140?'…':''}</p>
      <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:1.25rem;">
        ${p.stack.slice(0,4).map((s:string)=>`<span class="cy-tag">${s}</span>`).join('')}
      </div>
      <div style="padding-top:1rem;border-top:1px solid var(--line);display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.18em;color:var(--accent);text-transform:uppercase;">
        <span style="width:18px;height:1px;background:var(--accent);flex-shrink:0;display:inline-block;"></span>
        ${lang==='en'?'OPEN CASE':'VER CASO'}
