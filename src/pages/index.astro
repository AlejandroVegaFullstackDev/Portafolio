}

// ─── Now band entrance animation ──────────────────────────────────────────────
function initNowBand() {
  gsap.from('#nowBand .now-item', {
    x: 30, opacity: 0, duration: 0.55, stagger: 0.1, ease: 'expo.out', delay: 1.5,
  });
}

// ─── Cursor trail ─────────────────────────────────────────────────────────────
function initCursorTrail() {
  if (window.matchMedia('(hover: none)').matches) return;
  if (document.documentElement.hasAttribute('data-tweak-nocursor')) return;
  const TRAIL = 6;
  const dots: HTMLElement[] = [];
  const pos: {x:number,y:number}[] = [];
  for (let i = 0; i < TRAIL; i++) {
    const d = document.createElement('div');
    d.className = 'cy-trail';
    d.style.opacity = String(0.5 - i * 0.07);
    d.style.transform = `translate(-50%,-50%) scale(${1 - i * 0.12})`;
    document.body.appendChild(d);
    dots.push(d);
    pos.push({ x: 0, y: 0 });
  }
  let mx = 0, my = 0;
  window.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
  gsap.ticker.add(() => {
    pos[0].x += (mx - pos[0].x) * 0.35;
    pos[0].y += (my - pos[0].y) * 0.35;
    for (let i = 1; i < TRAIL; i++) {
      pos[i].x += (pos[i-1].x - pos[i].x) * 0.45;
      pos[i].y += (pos[i-1].y - pos[i].y) * 0.45;
    }
    dots.forEach((d, i) => { d.style.transform = `translate(${pos[i].x}px,${pos[i].y}px) translate(-50%,-50%)`; });
  });
}

// ─── Hero parallax ────────────────────────────────────────────────────────────
function initHeroPin() {
  if (document.documentElement.getAttribute('data-tweak-anim') !== 'high') return;
  const name = document.getElementById('heroName');
  if (!name) return;
  gsap.to(name, { yPercent: -15, ease: 'none', scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true } });
}

// ─── Image animations ─────────────────────────────────────────────────────────
function initImageAnimations() {
  // Hero background: fade in + scale down + scroll parallax
  const heroBg = document.getElementById('heroBg');
  if (heroBg) {
    const bgOpacity = window.matchMedia('(max-width: 767px)').matches ? 0.22 : 0.2;
    gsap.fromTo(heroBg,
      { scale: 1.08, opacity: 0 },
      { scale: 1, opacity: bgOpacity, duration: 2.4, ease: 'power2.out', delay: 1.2 }
    );
    gsap.to(heroBg, {
      yPercent: -15,
      ease: 'none',
      scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 1.5 }
    });
  }

  // Ingecat: CRT power-on + glitch burst + scanline + periodic glitch + chromatic hover
  const ingecat = document.getElementById('ingecatCard');
  const ingecatScan = document.getElementById('ingecatScan');
  const ingecatCorners = ingecat ? Array.from(ingecat.querySelectorAll<HTMLElement>('.ing-c')) : [];
  if (ingecat) {
    let isHovering = false;

    // ── Scanline sweep ──────────────────────────────────────────────────────
    function sweepScan() {
      if (!ingecatScan) return;
      gsap.fromTo(ingecatScan,
        { top: '-35%', opacity: 0 },
        { top: '125%', opacity: 1, duration: 1.9, ease: 'power1.inOut',
          onComplete: () => { gsap.set(ingecatScan, { opacity: 0 }); setTimeout(sweepScan, 4500 + Math.random() * 3000); } }
      );
    }

    // ── Periodic glitch ──────────────────────────────────────────────────────
    function doGlitch() {
      const delay = 3200 + Math.random() * 5000;
      setTimeout(() => {
        if (!isHovering) {
          const dramatic = Math.random() > 0.65;
          const tl = gsap.timeline({ onComplete: doGlitch });
          tl.to(ingecat, { x: dramatic ? -16 : -8, duration: 0.04, ease: 'none' })
            .to(ingecat, { x: dramatic ? 12 : 5, skewX: dramatic ? 3 : 1, duration: 0.04, ease: 'none' })
            .to(ingecat, { x: dramatic ? -7 : 0, skewX: 0, duration: 0.04, ease: 'none' });
          if (dramatic) {
            tl.to(ingecat, { x: 4, duration: 0.03, ease: 'none' });
          }
          tl.to(ingecat, { x: 0, duration: 0.12, ease: 'power2.out' });
        } else {
          doGlitch();
        }
      }, delay);
    }

    // ── Entrance ─────────────────────────────────────────────────────────────
    gsap.set(ingecat, { scaleY: 0.02, opacity: 1, transformPerspective: 900, transformOrigin: 'center center' });
    gsap.set(ingecatCorners, { opacity: 0 });

    ScrollTrigger.create({
      trigger: ingecat, start: 'top 88%', once: true,
      onEnter: () => {
        const tl = gsap.timeline();

        // CRT expand + brightness spike
        tl.to(ingecat, { scaleY: 1.07, duration: 0.3, ease: 'power3.out' })
          .to(ingecat, { scaleY: 0.97, duration: 0.1, ease: 'power2.inOut' })
          .to(ingecat, { scaleY: 1, duration: 0.18, ease: 'power2.out' })
          .set(ingecat, { filter: 'brightness(3.5)' }, '<-0.3')
          .to(ingecat, { filter: 'brightness(1)', duration: 0.55, ease: 'power2.out' }, '<')

        // Glitch burst
          .to(ingecat, { x: -18, duration: 0.04, ease: 'none' }, '<0.05')
          .to(ingecat, { x: 13, duration: 0.04, ease: 'none' })
          .set(ingecat, { filter: 'hue-rotate(110deg) brightness(1.6)' })
          .to(ingecat, { x: -8, duration: 0.04, ease: 'none' })
          .set(ingecat, { filter: 'hue-rotate(0deg) brightness(1)' })
          .to(ingecat, { x: 4, duration: 0.04, ease: 'none' })
          .to(ingecat, { x: 0, duration: 0.18, ease: 'power2.out' })

        // Corner accents flash in
          .to(ingecatCorners, { opacity: 1, duration: 0.04, stagger: 0.04, ease: 'none' }, '<-0.1')

        // Settle: float + start periodic effects
          .call(() => {
            gsap.to(ingecat, { y: -8, duration: 3.4, ease: 'sine.inOut', repeat: -1, yoyo: true });
            doGlitch();
            setTimeout(sweepScan, 1800);
          });
      },
    });

    // ── Hover: chromatic 3D tilt ───────────────────────────────────────────
    ingecat.addEventListener('mouseenter', () => {
      isHovering = true;
      gsap.timeline()
        .to(ingecat, { x: -5, duration: 0.04, ease: 'none' })
        .to(ingecat, { x: 0, duration: 0.12, ease: 'power2.out' });
    });

    ingecat.addEventListener('mousemove', (e: MouseEvent) => {
      const r = ingecat.getBoundingClientRect();
      const nx = ((e.clientX - r.left) / r.width  - 0.5) * 2;
      const ny = ((e.clientY - r.top)  / r.height - 0.5) * 2;
      const gx = (-nx * 18).toFixed(1);
      const gy = (ny  * 10).toFixed(1);
      gsap.to(ingecat, {
        rotateY: nx * 24, rotateX: -ny * 18, scale: 1.05,
        filter: `drop-shadow(${gx}px ${gy}px 22px rgba(255,0,60,0.5)) drop-shadow(${-Number(gx)*0.4}px ${-Number(gy)*0.4}px 14px rgba(0,120,255,0.35))`,
        transformPerspective: 700, duration: 0.35, ease: 'power3.out', overwrite: 'auto',
      });
    });

    ingecat.addEventListener('mouseleave', () => {
      isHovering = false;
      gsap.to(ingecat, {
        rotateY: 0, rotateX: 0, scale: 1, filter: 'none',
        duration: 0.9, ease: 'elastic.out(1, 0.4)', overwrite: 'auto',
      });
    });
  }

  // Sticker cluster: staggered bounce-in + independent idle floats + spring hover
  const stickers = Array.from(document.querySelectorAll<HTMLElement>('#stickerCluster .stk'));
  if (stickers.length) {
    stickers.forEach((stk) => {
      const rot = parseFloat(stk.dataset.rot || '0');
      gsap.set(stk, { opacity: 0, scale: 0, rotation: rot + gsap.utils.random(-25, 25) as number });
    });

    ScrollTrigger.create({
      trigger: '#contact', start: 'top 78%', once: true,
      onEnter: () => {
        stickers.forEach((stk, i) => {
          const rot = parseFloat(stk.dataset.rot || '0');
          gsap.to(stk, {
            opacity: 1, scale: 1, rotation: rot,
            duration: 0.7, ease: 'back.out(2.4)',
            delay: 0.07 * i,
            onComplete() {
              // Each sticker floats independently
              gsap.to(stk, {
                y: -gsap.utils.random(4, 9) as number,
                rotation: rot + (gsap.utils.random(-2.5, 2.5) as number),
                duration: gsap.utils.random(2.6, 4.1) as number,
                ease: 'sine.inOut', repeat: -1, yoyo: true,
              });
            },
          });
        });
      },
    });

    stickers.forEach((stk) => {
      const rot = parseFloat(stk.dataset.rot || '0');
      const popRot = rot + (Math.random() > 0.5 ? 10 : -10);

      const stkImg = stk.querySelector('img') as HTMLElement;
      stk.addEventListener('mouseenter', () => {
        gsap.to(stk, {
          scale: 1.22, rotation: popRot, zIndex: 10,
          duration: 0.22, ease: 'power2.out', overwrite: 'auto',
        });
        gsap.to(stkImg, {
          filter: 'drop-shadow(4px 8px 20px rgba(0,0,0,0.8)) drop-shadow(0 0 12px rgba(255,0,60,0.3))',
          duration: 0.22, ease: 'power2.out', overwrite: 'auto',
        });
      });

      stk.addEventListener('mouseleave', () => {
        gsap.to(stk, {
          scale: 1, rotation: rot, zIndex: 1,
          duration: 0.65, ease: 'elastic.out(1, 0.38)', overwrite: 'auto',
        });
        gsap.to(stkImg, {
          filter: 'drop-shadow(2px 4px 12px rgba(0,0,0,0.65))',
          duration: 0.65, ease: 'elastic.out(1, 0.38)', overwrite: 'auto',
        });
      });
    });
  }

}

// ─── Spotify now playing ──────────────────────────────────────────────────────
function initNowPlaying() {
  const item = document.getElementById('nowTrackItem');
  const icon = document.getElementById('nowPlayIcon');
  const text = document.getElementById('nowTrackText');

  // Sin dato real no se inventa una canción: la celda se oculta.
  const hide = () => { if (item) item.style.display = 'none'; };
  const show = () => { if (item) item.style.display = ''; };

  async function fetchNow() {
    try {
      const res = await fetch('/api/now-playing');
      if (!res.ok) return hide();
      const data = await res.json();

      // Update now-band
      if (icon && text) {
        if (data.title && data.artist) {
          show();
          const prefix = data.isPlaying ? '' : 'LAST: ';
          text.textContent = `${prefix}${data.artist.toUpperCase()} — ${data.title.toUpperCase()}`;
          icon.textContent = data.isPlaying ? '♫' : '↺';
        } else {
          hide();
        }
      }

      // Drive the SpotifyNow widget
      window.dispatchEvent(new CustomEvent('spotify:update', { detail: data }));
    } catch {
      hide();
    }
  }

  fetchNow();
  setInterval(fetchNow, 30_000);
}

// ─── Blog 3D: pila de páginas + filas que se voltean ──────────────────────────
function initBlog3D() {
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    || document.documentElement.getAttribute('data-tweak-anim') === 'off';
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  const stage = document.getElementById('paperStage');
  const float = document.getElementById('paperFloat');
  const rig = document.getElementById('paperRig');
  const tilt = document.getElementById('paperTilt');
  const shadow = document.getElementById('paperShadow');
  const pages = gsap.utils.toArray<HTMLElement>('#paperTilt .paper');

  // Estado final: hojas abiertas en abanico, vistas en 3/4.
  const fanned = {
    rig: { rotationX: 12, rotationY: -24, rotationZ: -4 },
    page: (i: number) => ({ z: -i * 44, x: -i * 20, y: -i * 12, rotationZ: -i * 5 }),
  };

  if (stage && rig && tilt && pages.length) {
    if (reduced) {
      gsap.set(rig, fanned.rig);
      pages.forEach((p, i) => gsap.set(p, fanned.page(i)));
    } else {
      // Estado inicial: pila cerrada, acostada como sobre un escritorio.
      gsap.set(rig, { rotationX: 62, rotationY: 0, rotationZ: -28 });
      pages.forEach((p, i) => gsap.set(p, { z: -i * 3, x: 0, y: 0, rotationZ: 0 }));
      if (shadow) gsap.set(shadow, { scaleX: 0.7, opacity: 0.5 });

      // El scroll levanta la pila y abre las hojas (scrub = ligado al dedo/rueda).
      const tl = gsap.timeline({
        scrollTrigger: { trigger: '#blog', start: 'top 85%', end: 'top top', scrub: 0.9 },
        defaults: { ease: 'none' },
      });
      tl.to(rig, fanned.rig, 0);
      pages.forEach((p, i) => tl.to(p, fanned.page(i), 0));
      if (shadow) tl.to(shadow, { scaleX: 1.15, opacity: 1 }, 0);

      // Flota suave en reposo.
      if (float) gsap.to(float, { y: -10, duration: 3.2, ease: 'sine.inOut', repeat: -1, yoyo: true });

      // Desktop: la pila sigue al cursor sobre toda la sección.
      if (finePointer) {
        const section = document.getElementById('blog');
        const rx = gsap.quickTo(tilt, 'rotationX', { duration: 0.8, ease: 'power3.out' });
        const ry = gsap.quickTo(tilt, 'rotationY', { duration: 0.8, ease: 'power3.out' });
        section?.addEventListener('pointermove', (e) => {
          const r = stage.getBoundingClientRect();
          const nx = gsap.utils.clamp(-1, 1, (e.clientX - (r.left + r.width / 2)) / (window.innerWidth / 2));
          const ny = gsap.utils.clamp(-1, 1, (e.clientY - (r.top + r.height / 2)) / (window.innerHeight / 2));
          ry(nx * 18);
          rx(-ny * 12);
        });
        section?.addEventListener('pointerleave', () => { rx(0); ry(0); });
      }

      // Hover/foco: la hoja del frente se levanta hacia el lector.
      const front = pages[0];
      const lift = () => gsap.to(front, { z: 46, rotationX: -6, duration: 0.5, ease: 'expo.out', overwrite: 'auto' });
      const drop = () => gsap.to(front, { z: 0, rotationX: 0, duration: 0.7, ease: 'expo.out', overwrite: 'auto' });
      stage.addEventListener('pointerenter', lift);
      stage.addEventListener('pointerleave', drop);
      stage.addEventListener('focus', lift);
      stage.addEventListener('blur', drop);
    }
  }

  if (reduced) return;

  // ── Scroll horizontal pinneado ────────────────────────────────────────────
  // Bajas → la sección se queda fija y el track avanza a la derecha.
  // Cada diapositiva hace coverflow 3D: entra girada desde el fondo, se planta
  // de frente en el centro y sale girando hacia el otro lado.
  const section = document.getElementById('blog');
  const viewport = document.getElementById('hsViewport');
  const track = document.getElementById('hsTrack');
  const bar = document.getElementById('hsBar');
  const idx = document.getElementById('hsIndex');
  const slides = gsap.utils.toArray<HTMLElement>('#hsTrack [data-hs-slide]');
  if (!section || !viewport || !track || slides.length < 2) return;

  ScrollTrigger.config({ ignoreMobileResize: true });
  section.classList.add('is-pinned');
  viewport.scrollLeft = 0;

  const distance = () => Math.max(0, track.scrollWidth - viewport.clientWidth);
  const pad = (n: number) => String(n).padStart(2, '0');
  // El blur en pantallas táctiles cuesta FPS: solo en desktop.
  const soft = (px: number) => (finePointer ? { filter: `blur(${px}px)` } : {});

  const scrollTween = gsap.to(track, {
    x: () => -distance(),
    ease: 'none',
    scrollTrigger: {
      trigger: section,
      start: 'top top',
      end: () => '+=' + distance(),
      pin: true,
      scrub: 1,
      anticipatePin: 1,
      invalidateOnRefresh: true,
      refreshPriority: 1,
      onUpdate: (self) => {
        if (bar) gsap.set(bar, { scaleX: self.progress });
        if (idx) idx.textContent = pad(Math.min(slides.length, Math.round(self.progress * (slides.length - 1)) + 1));
      },
    },
  });

  const along = (slide: HTMLElement, start: string, end: string) => ({
    trigger: slide, containerAnimation: scrollTween, start, end, scrub: true,
  });

  slides.forEach((slide, i) => {
    const inner = slide.querySelector<HTMLElement>('.hs-inner');
    if (!inner) return;
    const isLast = i === slides.length - 1;

    if (i === 0) {
      // Intro: se hunde en profundidad mientras entra el primer post.
      gsap.to(inner, {
        rotationY: -32, z: -340, opacity: 0.1, ...soft(4), ease: 'none', transformOrigin: '0% 50%',
        scrollTrigger: along(slide, 'left left', 'right left'),
      });
      return;
    }

    // Entrada
    gsap.fromTo(inner,
      { rotationY: 46, z: -380, opacity: 0.15, ...soft(6), transformOrigin: '50% 50%' },
      { rotationY: 0, z: 0, opacity: 1, ...soft(0), ease: 'none',
        scrollTrigger: along(slide, 'left right', isLast ? 'right 95%' : 'center center') });

    // Salida
    if (!isLast) {
      gsap.to(inner, {
        rotationY: -46, z: -380, opacity: 0.15, ...soft(6), ease: 'none', immediateRender: false,
        scrollTrigger: along(slide, 'center center', 'right left'),
      });
    }

    // Parallax interno: la portada se desliza más lento que la tarjeta.
    const media = slide.querySelector<HTMLElement>('.hs-media img, .hs-bignum');
    if (media) {
      gsap.fromTo(media, { xPercent: -9 }, { xPercent: 9, ease: 'none', scrollTrigger: along(slide, 'left right', 'right left') });
    }

    // El texto llega un poco después que la tarjeta (profundidad por capas).
    const copy = slide.querySelectorAll<HTMLElement>('.hs-meta, .hs-title, .hs-desc, .hs-tags, .hs-cta, .hs-end-kicker, .hs-end-title, .hs-end .cy-btn');
    if (copy.length) {
      gsap.fromTo(copy, { x: 80, opacity: 0 }, {
        x: 0, opacity: 1, stagger: 0.08, ease: 'none',
        scrollTrigger: along(slide, 'left 85%', isLast ? 'right 95%' : 'center 55%'),
      });
    }

    // Desktop: tilt sobre la diapositiva (no choca con el scrub del inner).
    if (finePointer && slide.classList.contains('hs-post')) {
      slide.addEventListener('pointermove', (e) => {
        const r = slide.getBoundingClientRect();
        const nx = (e.clientX - r.left) / r.width - 0.5;
        const ny = (e.clientY - r.top) / r.height - 0.5;
        gsap.to(slide, { rotationY: nx * 7, rotationX: -ny * 6, duration: 0.5, ease: 'power3.out', overwrite: 'auto' });
      });
      slide.addEventListener('pointerleave', () => {
        gsap.to(slide, { rotationY: 0, rotationX: 0, duration: 0.9, ease: 'elastic.out(1,0.45)', overwrite: 'auto' });
      });
    }
  });

  // Teclado: si el foco cae en una diapositiva, se lleva el scroll hasta ella.
  slides.forEach((slide, i) => {
    slide.addEventListener('focusin', () => {
      const st = scrollTween.scrollTrigger;
      if (!st) return;
      const y = st.start + (st.end - st.start) * (i / (slides.length - 1));
      window.scrollTo({ top: y, behavior: 'smooth' });
    });
  });
}

// ─── Main ─────────────────────────────────────────────────────────────────────
async function start() {
  await bootSequence();
  paintHero();
  paintAbout();
  paintStack();
  paintExp();
  paintProjects();
  // GSAP animations
  initCursor();
  initScramble();
  initMarquees();
  initReveals();
  initMagnetic();
  initCounters();
  initScrollProgress();
  initProjectTilt();
  initStackHover();
  initHeroPin();
  initExpAnimations();
  initEyebrows();
  initSpotlight();
  initCursorTrail();
  init3DTiles();
  initHeroGlitch();
  initCharReveal();
  initWaveHero();
  initNowClock();
  initNowBand();
  initImageAnimations();
  initNowPlaying();
  initBlog3D();

  // Hero name char-by-char reveal — more dramatic stagger
  gsap.from('#heroName .hc', { yPercent: 120, rotateX: -40, duration: 0.9, ease: 'expo.out', stagger: 0.025, delay: 0.1 });
  gsap.from('#hero p', { y: 30, opacity: 0, duration: 0.9, ease: 'expo.out', delay: 0.7 });
  gsap.from('#hero .cy-btn', { y: 24, opacity: 0, scale: 0.9, duration: 0.7, stagger: 0.12, ease: 'expo.out', delay: 0.9 });
  gsap.from('#hero .grid > div', { y: 40, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'expo.out', delay: 1.1 });

  // Lang toggle
  const langBtn = document.getElementById('langToggle');
  if (langBtn) {
    langBtn.addEventListener('click', () => {
      setLang(getLang() === 'es' ? 'en' : 'es');
      paintAbout(); paintStack(); paintExp(); paintProjects();
      init3DTiles();
      initProjectTilt();
      initStackHover();
      // Rebuild hero term with new lang
      const heroTerm = document.getElementById('heroTerm');
      if (heroTerm) { heroTerm.innerHTML = ''; paintHero(); }
    });
  }

  // Projects: destacados primero, el resto bajo demanda (acorta el home)
  const projToggle = document.getElementById('projectsToggle');
  if (projToggle) {
    const extra = projToggle.dataset.extra;
    const labelEs = projToggle.querySelector<HTMLElement>('[data-label-es]');
    const labelEn = projToggle.querySelector<HTMLElement>('[data-label-en]');
    projToggle.addEventListener('click', () => {
      projectsExpanded = !projectsExpanded;
      projToggle.setAttribute('aria-expanded', String(projectsExpanded));
      if (labelEs) labelEs.textContent = projectsExpanded ? 'MOSTRAR MENOS ↑' : `VER ${extra} PROYECTOS MÁS ↓`;
      if (labelEn) labelEn.textContent = projectsExpanded ? 'SHOW LESS ↑' : `SHOW ${extra} MORE PROJECTS ↓`;
      const extras = Array.from(document.querySelectorAll<HTMLElement>('.proj-extra'));
      extras.forEach((el) => { el.hidden = !projectsExpanded; });
      if (projectsExpanded) {
        gsap.fromTo(extras, { y: 24, opacity: 0 }, { y: 0, opacity: 1, scale: 1, filter: 'blur(0px)', duration: 0.6, stagger: 0.06, ease: 'expo.out' });
      } else {
        document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      ScrollTrigger.refresh();
    });
  }

  // Mobile menu
  const menuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const open = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      menuBtn.textContent = open ? '≡' : '✕';
    });
    mobileMenu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuBtn.textContent = '≡';
      });
    });
  }

  setTimeout(() => ScrollTrigger.refresh(), 200);
}

start();
</script>
</Layout>
