// ─── Terminal game ────────────────────────────────────────────────────────────
function attachTerminalGame(container: HTMLElement, lang: 'es' | 'en') {
  const COMMANDS: Record<string, (args: string[], lang: 'es'|'en') => string[]> = {
    help: (_, l) => l === 'en'
      ? ['Available commands:','  about       — who I am','  stack       — tech stack','  projects    — recent projects','  contact     — how to reach me','  whoami      — system identity','  snake       — classic game','  matrix      — matrix rain','  hack        — hacking sequence','  clear       — clear terminal']
      : ['Comandos disponibles:','  about       — quién soy','  stack       — stack tecnológico','  projects    — proyectos recientes','  contact     — cómo contactarme','  whoami      — identidad del sistema','  snake       — juego clásico','  matrix      — lluvia matrix','  hack        — secuencia de hackeo','  clear       — limpiar terminal'],
    whoami: (_, l) => [
      D.identity.name.toLowerCase().replace(' ', '_'),
      `role: ${D.identity.title[l].toLowerCase()}`,
      `loc:  ${D.identity.location[l].toLowerCase()} / ${D.identity.timezone.toLowerCase()}`,
      `avail: ${l === 'en' ? 'yes — remote / hybrid' : 'sí — remoto / híbrido'}`,
    ],
    about: (_, l) => D.about[l],
    stack: () => [
      `Backend:  ${[...D.stack.languages, ...D.stack.frameworks.slice(0, 3)].join(' · ')}`,
      `Frontend: ${D.stack.frameworks.slice(3, 5).join(' · ')} · Tailwind`,
      `Data:     ${D.stack.databases.join(' · ')}`,
      `Cloud:    ${D.stack.cloud.join(' · ')}`,
    ],
    projects: (_, l) => D.projects.map((p: any) => `[${p.n}] ${p.name[l]} — ${p.stack.slice(0, 2).join(' · ')}`),
    contact: () => [
      `linkedin: ${D.identity.contact.linkedin.replace('https://www.linkedin.com', '').replace(/\/$/, '')}`,
      `github:   /${D.identity.contact.github.split('/').pop()}`,
      `email:    ${D.identity.contact.email}`,
      'response: < 24h',
      'status:   ● available',
    ],
    date: () => [new Date().toString()],
    clear: () => [],
  };

  const screen = document.createElement('div');
  screen.className = 'tg-screen';
  screen.tabIndex = 0;

  const history: HTMLElement[] = [];
  let cmdHistory: string[] = [];
  let histIdx = -1;

  function addLine(text: string, cls = '') {
    const d = document.createElement('div');
    d.className = 'tg-line' + (cls ? ' ' + cls : '');
    d.textContent = text;
    screen.insertBefore(d, prompt);
    screen.scrollTop = screen.scrollHeight;
    history.push(d);
  }

  function addLines(lines: string[], cls = '') { lines.forEach((l) => addLine(l, cls)); }

  // Matrix rain
  let matrixActive = false;
  const overlay = document.createElement('canvas');
  overlay.className = 'tg-overlay';
  overlay.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;display:none;';

  function startMatrix() {
    if (matrixActive) return;
    matrixActive = true;
    overlay.style.display = 'block';
    overlay.width = screen.offsetWidth;
    overlay.height = screen.offsetHeight;
    const ctx = overlay.getContext('2d')!;
    const cols = Math.floor(overlay.width / 14);
    const drops = Array(cols).fill(1);
    const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789';
    const iv = setInterval(() => {
      if (!matrixActive) { clearInterval(iv); overlay.style.display = 'none'; return; }
      ctx.fillStyle = 'rgba(0,0,0,0.05)';
      ctx.fillRect(0, 0, overlay.width, overlay.height);
      ctx.fillStyle = '#0f0';
      ctx.font = '12px monospace';
      drops.forEach((y, x) => {
        ctx.fillText(chars[Math.floor(Math.random() * chars.length)], x * 14, y * 14);
        if (y * 14 > overlay.height && Math.random() > 0.975) drops[x] = 0;
        drops[x]++;
      });
    }, 50);
    setTimeout(() => { matrixActive = false; }, 4000);
  }

  // Snake game — canvas renderer
  let snakeActive = false;
  function startSnake() {
    if (snakeActive) return;
    snakeActive = true;

    const CELL = 14;
    const cols = Math.floor((screen.clientWidth - 16) / CELL) || 28;
    const W = Math.min(cols, 32);
    const H = 16;
    const isTouch = window.matchMedia('(hover: none)').matches;

    let snake = [{x:Math.floor(W/2),y:Math.floor(H/2)},{x:Math.floor(W/2)-1,y:Math.floor(H/2)},{x:Math.floor(W/2)-2,y:Math.floor(H/2)}];
    let food  = {x:Math.floor(Math.random()*W), y:Math.floor(Math.random()*H)};
    let dir   = {x:1,y:0};
    let score = 0;

    const hdr = document.createElement('div');
    hdr.className = 'tg-line tg-hack';
    hdr.textContent = isTouch
      ? (lang==='en' ? '▶ SNAKE — swipe or D-pad' : '▶ SNAKE — desliza o usa el pad')
      : (lang==='en' ? '▶ SNAKE — arrows · Q quit' : '▶ SNAKE — flechas · Q salir');

    const canvas = document.createElement('canvas');
    canvas.width  = W * CELL;
    canvas.height = H * CELL;
    canvas.style.cssText = 'display:block;margin:4px 0;border:1px solid #1a1a1a;image-rendering:pixelated;touch-action:none;max-width:100%;';

    const scoreLine = document.createElement('div');
    scoreLine.className = 'tg-line tg-echo';
    scoreLine.textContent = `${lang==='en'?'Score':'Puntaje'}: 0`;

    // D-pad (touch only)
    let dpad: HTMLElement | null = null;
    if (isTouch) {
      dpad = document.createElement('div');
      dpad.style.cssText = 'display:grid;grid-template-columns:repeat(3,50px);grid-template-rows:repeat(2,50px);gap:4px;margin:8px auto 4px;width:158px;';
      const mkBtn = (txt: string, col: number, row: number, fn: ()=>void) => {
        const b = document.createElement('button');
        b.textContent = txt;
        b.style.cssText = `grid-column:${col};grid-row:${row};background:var(--panel);border:1px solid var(--line-2);color:var(--accent);font-size:1.4rem;line-height:1;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent;`;
        b.addEventListener('touchstart', (e)=>{ fn(); e.preventDefault(); }, {passive:false});
        dpad!.appendChild(b);
      };
      mkBtn('↑',2,1,()=>{ if(dir.y===0) dir={x:0,y:-1}; });
      mkBtn('←',1,2,()=>{ if(dir.x===0) dir={x:-1,y:0}; });
      mkBtn('↓',2,2,()=>{ if(dir.y===0) dir={x:0,y:1}; });
      mkBtn('→',3,2,()=>{ if(dir.x===0) dir={x:1,y:0}; });
    }

    screen.insertBefore(scoreLine, prompt);
    if (dpad) screen.insertBefore(dpad, scoreLine);
    screen.insertBefore(canvas, dpad ?? scoreLine);
    screen.insertBefore(hdr, canvas);

    const ctx = canvas.getContext('2d')!;
    const C_BG   = '#050507';
    const C_GRID = 'rgba(255,255,255,0.025)';
    const C_HEAD = '#5cffb1';
    const C_BODY = '#2a9966';
    const C_FOOD = '#ff003c';

    function render() {
      ctx.fillStyle = C_BG;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.strokeStyle = C_GRID; ctx.lineWidth = 0.5;
      for(let x=0;x<=W;x++){ctx.beginPath();ctx.moveTo(x*CELL,0);ctx.lineTo(x*CELL,H*CELL);ctx.stroke();}
      for(let y=0;y<=H;y++){ctx.beginPath();ctx.moveTo(0,y*CELL);ctx.lineTo(W*CELL,y*CELL);ctx.stroke();}
      ctx.fillStyle=C_FOOD; ctx.shadowColor=C_FOOD; ctx.shadowBlur=10;
      ctx.fillRect(food.x*CELL+2,food.y*CELL+2,CELL-4,CELL-4); ctx.shadowBlur=0;
      for(let i=snake.length-1;i>=0;i--){
        const s=snake[i];
        ctx.fillStyle=i===0?C_HEAD:C_BODY; ctx.shadowColor=i===0?C_HEAD:'transparent'; ctx.shadowBlur=i===0?12:0;
        const pad=i===0?1:2; ctx.fillRect(s.x*CELL+pad,s.y*CELL+pad,CELL-pad*2,CELL-pad*2);
      }
      ctx.shadowBlur=0;
      scoreLine.textContent=`${lang==='en'?'Score':'Puntaje'}: ${score}`;
    }

    let iv: ReturnType<typeof setInterval>;
    function cleanup(msg: string, cls: string) {
      snakeActive=false; clearInterval(iv); document.removeEventListener('keydown',keyH);
      hdr.remove(); canvas.remove(); scoreLine.remove(); if(dpad) dpad.remove();
      addLine(msg, cls);
    }

    // Swipe detection
    let ts={x:0,y:0};
    canvas.addEventListener('touchstart',(e)=>{ts={x:e.touches[0].clientX,y:e.touches[0].clientY};e.preventDefault();},{passive:false});
    canvas.addEventListener('touchend',(e)=>{
      const dx=e.changedTouches[0].clientX-ts.x, dy=e.changedTouches[0].clientY-ts.y;
      if(Math.max(Math.abs(dx),Math.abs(dy))<15) return;
      if(Math.abs(dx)>Math.abs(dy)){if(dx>0&&dir.x===0)dir={x:1,y:0};else if(dx<0&&dir.x===0)dir={x:-1,y:0};}
      else{if(dy>0&&dir.y===0)dir={x:0,y:1};else if(dy<0&&dir.y===0)dir={x:0,y:-1};}
      e.preventDefault();
    },{passive:false});

    const keyH = (e: KeyboardEvent) => {
      if(!snakeActive) return;
      if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.key)) e.preventDefault();
      if     (e.key==='ArrowUp'    && dir.y===0) dir={x:0,y:-1};
      else if(e.key==='ArrowDown'  && dir.y===0) dir={x:0,y:1};
      else if(e.key==='ArrowLeft'  && dir.x===0) dir={x:-1,y:0};
      else if(e.key==='ArrowRight' && dir.x===0) dir={x:1,y:0};
      else if(e.key==='q'||e.key==='Q') cleanup(lang==='en'?'Snake quit.':'Snake salido.','tg-echo');
    };
    document.addEventListener('keydown', keyH);

    iv = setInterval(() => {
      if(!snakeActive){clearInterval(iv);return;}
      const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};
      if(head.x<0||head.x>=W||head.y<0||head.y>=H||snake.some(s=>s.x===head.x&&s.y===head.y)){
        cleanup(`GAME OVER · ${lang==='en'?'Score':'Puntaje'}: ${score}`,'tg-err'); return;
      }
      snake.unshift(head);
      if(head.x===food.x&&head.y===food.y){score++;food={x:Math.floor(Math.random()*W),y:Math.floor(Math.random()*H)};}
      else snake.pop();
      render();
    }, 110);
    render();
  }

  // Hack sequence
  function startHack() {
    const steps = lang === 'en'
      ? ['Scanning target...','Bypassing firewall...','Injecting payload...','Escalating privileges...','ACCESS GRANTED — welcome, hacker.']
      : ['Escaneando objetivo...','Saltando firewall...','Inyectando payload...','Escalando privilegios...','ACCESO CONCEDIDO — bienvenido, hacker.'];
    let i = 0;
    function next() {
      if (i >= steps.length) return;
      addLine(steps[i++], 'tg-hack');
      setTimeout(next, 400 + Math.random() * 400);
    }
    next();
  }

  // DOOM easter egg
  function startDoom() {
    const logo = [
      '██████╗  ██████╗  ██████╗ ███╗   ███╗',
      '██╔══██╗██╔═══██╗██╔═══██╗████╗ ████║',
      '██║  ██║██║   ██║██║   ██║██╔████╔██║',
      '██║  ██║██║   ██║██║   ██║██║╚██╔╝██║',
      '██████╔╝╚██████╔╝╚██████╔╝██║ ╚═╝ ██║',
      '╚═════╝  ╚═════╝  ╚═════╝ ╚═╝     ╚═╝',
    ];
    logo.forEach(l => addLine(l, 'tg-doom'));
    const steps = lang === 'en'
      ? ['', 'LOADING HELL...  please wait',
         '[░░░░░░░░░░░░░░░░░░░░]   0%',
         '[████░░░░░░░░░░░░░░░░]  20%',
         '[████████░░░░░░░░░░░░]  40%',
         '[████████████░░░░░░░░]  60%',
         '[████████████████░░░░]  80%',
         '[████████████████████] 100%', '',
         'ERROR: PC_TOO_SLOW',
         'REQUIRED: PENTIUM 90MHz · 4MB RAM · VGA',
         'FOUND:    🐌  PATHETIC HARDWARE', '',
         '>>> TOO SLOW. GET A REAL PC. <<<']
      : ['', 'CARGANDO EL INFIERNO...  por favor espera',
         '[░░░░░░░░░░░░░░░░░░░░]   0%',
         '[████░░░░░░░░░░░░░░░░]  20%',
         '[████████░░░░░░░░░░░░]  40%',
         '[████████████░░░░░░░░]  60%',
         '[████████████████░░░░]  80%',
         '[████████████████████] 100%', '',
         'ERROR: PC_DEMASIADO_LENTO',
         'REQUERIDO: PENTIUM 90MHz · 4MB RAM · VGA',
         'ENCONTRADO: 🐌  HARDWARE PATÉTICO', '',
         '>>> DEMASIADO LENTO. CONSIGUE UN PC REAL. <<<'];
    const delays = [0,200,120,160,140,160,140,220,100,350,280,340,180,600];
    let i = 0;
    function next() {
      if (i >= steps.length) return;
      const s = steps[i], d = delays[i] ?? 200; i++;
      const cls = s.startsWith('>>>') ? 'tg-hack'
        : (s.startsWith('ERROR') || s.startsWith('REQUIRED') || s.startsWith('FOUND')
           || s.startsWith('REQUERIDO') || s.startsWith('ENCONTRADO')) ? 'tg-err' : 'tg-echo';
      addLine(s || ' ', cls);
      setTimeout(next, d);
    }
    setTimeout(next, 80);
  }

  const prompt = document.createElement('div');
  prompt.className = 'tg-prompt';
  const ps1 = document.createElement('span');
  ps1.className = 'tg-ps1';
  ps1.textContent = '▸';
  const input = document.createElement('input');
  input.className = 'tg-input';
  input.type = 'text';
  input.autocomplete = 'off';
  input.spellcheck = false;
  prompt.appendChild(ps1);
  prompt.appendChild(input);
  screen.appendChild(prompt);
  container.appendChild(overlay);
  container.appendChild(screen);

  addLine(lang === 'en' ? 'stackblend.shell v1.0 — type "help" to start' : 'stackblend.shell v1.0 — escribe "help" para comenzar');

  screen.addEventListener('click', () => input.focus());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const cmd = input.value.trim().toLowerCase();
      input.value = '';
      if (!cmd) return;
      cmdHistory.unshift(cmd);
      histIdx = -1;
      addLine('▸ ' + cmd, 'tg-echo');
      if (cmd === 'clear') { history.forEach((l) => l.remove()); history.length = 0; return; }
      if (cmd === 'matrix') { startMatrix(); return; }
      if (cmd === 'snake') { startSnake(); return; }
      if (cmd === 'hack') { startHack(); return; }
      if (cmd === 'doom') { startDoom(); return; }
      const fn = COMMANDS[cmd];
      if (fn) addLines(fn([], lang));
      else addLine(lang === 'en' ? `Command not found: ${cmd}. Type "help".` : `Comando no encontrado: ${cmd}. Escribe "help".`, 'tg-err');
    }
    if (e.key === 'ArrowUp') { histIdx = Math.min(histIdx + 1, cmdHistory.length - 1); input.value = cmdHistory[histIdx] || ''; }
    if (e.key === 'ArrowDown') { histIdx = Math.max(histIdx - 1, -1); input.value = histIdx >= 0 ? cmdHistory[histIdx] : ''; }
  });
}

// ─── Char-level reveal for accent words in section headings ─────────────────
function initCharReveal() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;
  document.querySelectorAll<HTMLElement>('section h2 .text-\\[var\\(--accent\\)\\]').forEach((el) => {
    if (el.classList.contains('cy-glitch')) return;
    const text = el.textContent || '';
    if (!text.trim()) return;
    el.innerHTML = text.split('').map((c) =>
      `<span style="display:inline-block;will-change:transform">${c}</span>`
    ).join('');
    const h2 = el.closest('h2') || el;
    ScrollTrigger.create({
      trigger: h2,
      start: 'top 82%', once: true,
      onEnter: () => {
        gsap.from(el.querySelectorAll('span'), {
          y: 55, opacity: 0, rotateX: -80, scaleY: 0.3,
          transformPerspective: 500,
          duration: 0.65, stagger: 0.05, ease: 'expo.out', delay: 0.3,
        });
      },
    });
  });
}

// ─── Continuous wave on hero name chars ──────────────────────────────────────
function initWaveHero() {
  const anim = document.documentElement.getAttribute('data-tweak-anim');
  if (anim === 'off' || anim === 'low') return;
  const chars = document.querySelectorAll<HTMLElement>('#heroName .hc');
  if (!chars.length) return;
  gsap.to(chars, {
    y: -6,
    duration: 0.88,
    ease: 'sine.inOut',
    stagger: { each: 0.065, repeat: -1, yoyo: true },
    delay: 1.6,
  });
}

// ─── Spotlight ────────────────────────────────────────────────────────────────
function initSpotlight() {
  if (window.matchMedia('(hover: none)').matches) return;
  const el = document.createElement('div');
  el.className = 'cy-spotlight';
  document.body.appendChild(el);
  window.addEventListener('mousemove', (e) => {
    gsap.to(el, { x: e.clientX, y: e.clientY, duration: 1.4, ease: 'power3.out' });
  });
}

// ─── 3-D tilt on project tiles & service cards ────────────────────────────────
function init3DTiles() {
  if (window.matchMedia('(hover: none)').matches) return;
  document.querySelectorAll<HTMLElement>('.cy-tile, .service-card').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const r = el.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width - 0.5) * 2;
      const y = ((e.clientY - r.top) / r.height - 0.5) * 2;
      gsap.to(el, { rotateX: -y * 7, rotateY: x * 7, transformPerspective: 900, duration: 0.45, ease: 'power3.out' });
    });
    el.addEventListener('mouseleave', () => {
      gsap.to(el, { rotateX: 0, rotateY: 0, duration: 0.9, ease: 'elastic.out(1,0.35)' });
    });
  });
}

// ─── Periodic hero name glitch ────────────────────────────────────────────────
function initHeroGlitch() {
  if (document.documentElement.getAttribute('data-tweak-anim') === 'off') return;
  function glitch() {
    const chars = Array.from(document.querySelectorAll<HTMLElement>('#heroName .hc'));
    if (!chars.length) return;
    const picked = chars.filter(() => Math.random() > 0.75);
    if (!picked.length) return;
    gsap.to(picked, {
      x: () => gsap.utils.random(-8, 8),
      skewX: () => gsap.utils.random(-7, 7),
      color: () => Math.random() > 0.4 ? 'var(--accent)' : 'var(--ink)',
      duration: 0.07, ease: 'none',
      onComplete: () => gsap.to(picked, { x: 0, skewX: 0, color: 'var(--ink)', duration: 0.15, ease: 'power2.out' }),
    });
  }
  gsap.delayedCall(2.8, () => setInterval(() => { if (Math.random() < 0.4) glitch(); }, 2500));
}

// ─── Now clock (live Bogotá time) ─────────────────────────────────────────────
function initNowClock() {
  const el = document.getElementById('nowClock');
  if (!el) return;
  function tick() {
    el.textContent = new Date().toLocaleTimeString('es-CO', {
      timeZone: 'America/Bogota', hour: '2-digit', minute: '2-digit', second: '2-digit',
    });
