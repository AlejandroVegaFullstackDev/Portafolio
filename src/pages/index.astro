<style>
  [data-tweak-theme="light"] [data-header] {
    background: rgba(243,241,236,0.7) !important;
  }

  /* ─── Blog: scroll horizontal pinneado ───
     Sin JS (o con reduced-motion) es un carrusel con swipe nativo + scroll-snap.
     Con JS, GSAP pinea la sección y traduce el track: bajas → avanza a la derecha. */
  .hs { position: relative; background: var(--bg); }
  .hs-viewport {
    position: relative; height: 100svh; min-height: 560px;
    overflow-x: auto; overflow-y: hidden;
    scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    perspective: 1400px; perspective-origin: 50% 50%;
    scrollbar-width: none;
  }
  .hs-viewport::-webkit-scrollbar { display: none; }
  .hs.is-pinned .hs-viewport { overflow: hidden; scroll-snap-type: none; }
  .hs-track {
    display: flex; align-items: center; gap: 4vw;
    height: 100%; width: max-content;
    padding: 64px 9vw 72px 0;
    transform-style: preserve-3d; will-change: transform;
  }
  .hs-slide {
    flex: 0 0 auto; scroll-snap-align: center;
    width: min(78vw, 1080px); height: min(70svh, 640px);
    transform-style: preserve-3d;
    color: inherit; text-decoration: none; display: block;
  }
  .hs-inner {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d; will-change: transform, opacity;
  }

  /* Intro */
  .hs-intro { width: 100vw; height: 100%; }
  .hs-intro .hs-inner {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center; gap: 2.5rem;
    padding: 0 5rem; max-width: 1480px; margin: 0 auto;
  }
  .hs-hint {
    margin-top: 2.5rem; display: inline-flex; align-items: center; gap: 0.75rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--accent);
  }
  .hs-hint-arrow { display: inline-block; animation: hsNudge 1.6s cubic-bezier(.16,1,.3,1) infinite; }
  @keyframes hsNudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(10px); } }

  /* Post slide */
  .hs-post .hs-inner {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    background: linear-gradient(150deg, var(--panel), var(--bg-2));
    border: 1px solid var(--line-2);
    box-shadow: 0 40px 80px -40px rgba(0,0,0,0.8);
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .hs-post:hover .hs-inner, .hs-post:focus-visible .hs-inner { border-color: var(--accent); }
  .hs-post:focus-visible { outline: none; }
  .hs-media {
    position: relative; display: flex; align-items: center; justify-content: center;
    overflow: hidden; border-right: 1px solid var(--line); background: var(--bg-2);
  }
  .hs-media img {
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transform: scale(1.12); will-change: transform;
  }
  .hs-bignum {
    font-family: var(--font-display); font-weight: 700; line-height: 0.8;
    font-size: clamp(8rem, 22vw, 18rem); letter-spacing: -0.06em;
    color: transparent; -webkit-text-stroke: 1px var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .hs-copy {
    display: flex; flex-direction: column; justify-content: center; gap: 1.1rem;
    padding: clamp(1.5rem, 4vw, 3.5rem); min-width: 0;
  }
  .hs-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-3); font-variant-numeric: tabular-nums;
  }
  .hs-new { color: var(--accent); border: 1px solid var(--accent); padding: 1px 6px; letter-spacing: 0.14em; }
  .hs-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.9rem, 4.2vw, 3.8rem); line-height: 0.98; letter-spacing: -0.035em;
    color: var(--ink); text-wrap: balance;
  }
  .hs-desc { color: var(--ink-2); font-size: 1.02rem; line-height: 1.6; max-width: 46ch; }
  .hs-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .hs-cta {
    margin-top: 0.5rem; font-family: var(--font-mono); font-size: 0.78rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }

  /* Final */
  .hs-end { width: min(70vw, 900px); }
  .hs-end .hs-inner {
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 1.75rem;
    padding: 0 1rem;
  }
  .hs-end-kicker { font-size: 0.74rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); }
  .hs-end-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.6rem, 7vw, 6rem); line-height: 0.92; letter-spacing: -0.04em;
  }

  /* HUD */
  .hs-hud {
    position: absolute; left: 50%; bottom: 26px; transform: translateX(-50%);
    width: min(84vw, 520px);
    display: flex; align-items: center; gap: 14px;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em;
    color: var(--ink-3); font-variant-numeric: tabular-nums; pointer-events: none;
  }
  .hs-count { flex-shrink: 0; }
  .hs-count #hsIndex { color: var(--accent); }
  .hs-bar { flex: 1; height: 1px; background: var(--line-2); position: relative; overflow: hidden; }
  .hs-bar-fill { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left; }

  @media (max-width: 1023px) {
    .hs-intro .hs-inner { grid-template-columns: 1fr; padding: 0 1.5rem; gap: 1rem; align-content: center; }
    .hs-intro .cy-headline { font-size: clamp(2.4rem, 11vw, 4rem) !important; margin-bottom: 0 !important; }
    .hs-intro .hs-hint { margin-top: 1rem; }
    .hs-slide { width: 84vw; height: min(72svh, 620px); }
    .hs-intro { width: 100vw; height: 100%; }
    .hs-post .hs-inner { grid-template-columns: 1fr; grid-template-rows: 38% 1fr; }
    .hs-media { border-right: 0; border-bottom: 1px solid var(--line); }
    .hs-copy { justify-content: flex-start; gap: 0.75rem; padding: 1.25rem; }
    .hs-desc { font-size: 0.92rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .hs-bignum { font-size: 7rem; }
    .hs-end { width: 84vw; }
  }
  @media (max-width: 1023px) {
    .hs-track { padding: 56px 8vw 64px 0; }
    .hs-intro .paper-stage { --pw: 160px; --ph: 210px; height: calc(var(--ph) + 50px); }
  }
  @media (max-width: 1023px) and (max-height: 720px) {
    .hs-intro .paper-stage { --pw: 132px; --ph: 172px; }
    .hs-intro .paper-title { font-size: 0.92rem; }
    .hs-intro-copy > p.font-mono { display: none; }
  }

  /* ─── Pila de páginas 3D (CSS 3D + GSAP) ─── */
  .paper-stage {
    --pw: 230px; --ph: 300px;
    position: relative; display: block;
    height: calc(var(--ph) + 90px);
    perspective: 1100px; perspective-origin: 50% 30%;
    color: inherit; text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .paper-stage:focus-visible { outline: 1px solid var(--accent); outline-offset: 6px; }
  .paper-float, .paper-rig, .paper-tilt {
    position: absolute; inset: 0; display: block;
    transform-style: preserve-3d;
  }
  .paper-float { top: 10px; }
  .paper {
    position: absolute; left: 50%; top: 50%;
    width: var(--pw); height: var(--ph);
    margin: calc(var(--ph) / -2) 0 0 calc(var(--pw) / -2);
    display: flex; flex-direction: column; gap: 14px;
    padding: 18px 18px 16px;
    background: linear-gradient(160deg, var(--panel) 0%, var(--bg-2) 100%);
    border: 1px solid var(--line-2);
    box-shadow: 0 18px 40px -18px rgba(0,0,0,0.65);
    backface-visibility: hidden;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .paper.is-front { border-color: var(--accent); }
  .paper.is-front::before {
