---
// Home. Este archivo solo ARMA la página: cada sección es un componente en
// components/sections y toda la interacción la orquesta scripts/home.ts.
// Ver ARCHITECTURE.md para saber dónde vive cada cosa.
import Layout from '../layouts/Layout.astro';
import BootScreen from '../components/layout/BootScreen.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import NowBand from '../components/layout/NowBand.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Stack from '../components/sections/Stack.astro';
import Projects from '../components/sections/Projects.astro';
import Blog from '../components/sections/Blog.astro';
import Experience from '../components/sections/Experience.astro';
import PlaylistSnake from '../components/sections/PlaylistSnake.astro';
import Contact from '../components/sections/Contact.astro';
import SecretTerminal from '../components/ui/SecretTerminal.astro';
import SpotifyNow from '../components/SpotifyNow.astro';
import TweaksPanel from '../components/TweaksPanel';
import { portfolioData as D } from '../data';
import { getSortedPosts } from '../lib/blog';
import { buildTicker } from '../lib/ticker';

const [latest] = await getSortedPosts();
const ticker = buildTicker(latest?.data.title);
---
<Layout title={`${D.identity.name} — Full Stack Developer`}>
  <BootScreen />
  <Header ticker={ticker} />
  <MobileMenu />

  <main class="pt-[78px] overflow-x-clip">
    <Hero />
    <NowBand />
    <About />
    <Stack />
    <Experience />
    <Projects />
    <Blog />
    <PlaylistSnake />
    <Contact />
  </main>

  <SecretTerminal />
  <TweaksPanel client:only="react" />
  <SpotifyNow />
</Layout>

<script>
  import '../scripts/home';
</script>
