</section>

<!-- BLOG: scroll horizontal pinneado (bajas → las diapositivas pasan a la derecha) -->
<section id="blog" class="hs border-y border-[var(--line)]" aria-label="Blog">
  <div class="hs-viewport" id="hsViewport">
    <div class="hs-track" id="hsTrack">

      <!-- 01 · Intro -->
      <div class="hs-slide hs-intro" data-hs-slide>
        <div class="hs-inner">
          <div class="hs-intro-copy">
            <div class="cy-eyebrow mb-4" data-scramble>
              <span class="lang-es">// 04 _ BLOG</span>
              <span class="lang-en">// 04 _ BLOG</span>
            </div>
            <h2 class="cy-headline text-5xl lg:text-7xl">
              <span class="lang-es">Lo que <span class="text-[var(--accent)]">escribo</span>.</span>
              <span class="lang-en">What I <span class="text-[var(--accent)]">write</span>.</span>
            </h2>
            <p class="font-mono text-sm text-[var(--ink-3)] max-w-sm mt-6">
              <span class="lang-es">Código, IA, aprendizaje y lo que me esté dando vueltas. Sin algoritmos de por medio.</span>
              <span class="lang-en">Code, AI, learning and whatever is on my mind. Posts are in Spanish.</span>
            </p>
            <p class="hs-hint" aria-hidden="true">
              <span class="lang-es">sigue bajando</span><span class="lang-en">keep scrolling</span>
              <span class="hs-hint-arrow">→</span>
            </p>
          </div>
          {latestPosts[0] && (
        <div class="hs-intro-stack">
          <a href={`/blog/${latestPosts[0].slug}`} class="paper-stage" id="paperStage" aria-label={`Leer el último post: ${latestPosts[0].data.title}`} data-cursor>
            <span class="paper-float" id="paperFloat">
              <span class="paper-rig" id="paperRig">
                <span class="paper-tilt" id="paperTilt">
                  {paperPages.map((post, i) => (
                    <span class={`paper${i === 0 ? ' is-front' : ''}`} aria-hidden="true">
                      <span class="paper-top">
                        <span>POST_{post ? String(allPosts.length - i).padStart(2, '0') : '··'}</span>
                        {post && <span>{fmtPostDate(post.data.date)}</span>}
                      </span>
                      {post
                        ? <span class="paper-title">{post.data.title}</span>
                        : <span class="paper-title paper-title--draft">borrador…</span>}
                      <span class="paper-lines"></span>
                      <span class="paper-foot">
                        <span>{post ? `${readingTime(post.body)} min` : '—'}</span>
                        {i === 0 && <span class="paper-cta"><span class="lang-es">leer →</span><span class="lang-en">read →</span></span>}
                      </span>
                    </span>
                  ))}
                </span>
              </span>
            </span>
            <span class="paper-shadow" id="paperShadow" aria-hidden="true"></span>
          </a>
        </div>
      )}
        </div>
      </div>

      <!-- Posts -->
      {latestPosts.map((post, i) => (
        <a href={`/blog/${post.slug}`} class="hs-slide hs-post" data-hs-slide data-cursor>
          <span class="hs-inner">
            <span class="hs-media" aria-hidden="true">
              {post.data.cover
                ? <img src={post.data.cover} alt="" loading="lazy" decoding="async" />
                : <span class="hs-bignum">{String(allPosts.length - i).padStart(2, '0')}</span>}
            </span>
            <span class="hs-copy">
              <span class="hs-meta">
                <time datetime={post.data.date.toISOString()}>{fmtPostDate(post.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{readingTime(post.body)} min</span>
                {i === 0 && <span class="hs-new"><span class="lang-es">nuevo</span><span class="lang-en">new</span></span>}
              </span>
              <span class="hs-title">{post.data.title}</span>
              {post.data.description && <span class="hs-desc">{post.data.description}</span>}
              {post.data.tags.length > 0 && (
                <span class="hs-tags">{post.data.tags.slice(0, 3).map((t) => <span class="cy-tag">{t}</span>)}</span>
              )}
              <span class="hs-cta"><span class="lang-es">Leer post</span><span class="lang-en">Read post</span> <span aria-hidden="true">→</span></span>
            </span>
          </span>
        </a>
      ))}

      <!-- Final -->
      <div class="hs-slide hs-end" data-hs-slide>
        <div class="hs-inner">
          <p class="hs-end-kicker font-mono"><span class="lang-es">fin del carrete</span><span class="lang-en">end of the reel</span></p>
          <p class="hs-end-title">
            <span class="lang-es">¿Quieres leer <span class="text-[var(--accent)]">más</span>?</span>
            <span class="lang-en">Want to read <span class="text-[var(--accent)]">more</span>?</span>
          </p>
          <a href="/blog" class="cy-btn solid">
            <span class="lang-es">TODOS LOS POSTS ({allPosts.length}) ↗</span>
            <span class="lang-en">ALL POSTS ({allPosts.length}) ↗</span>
          </a>
        </div>
      </div>

    </div>

    <!-- HUD -->
    <div class="hs-hud" aria-hidden="true">
      <span class="hs-count"><span id="hsIndex">01</span> / {String(latestPosts.length + 2).padStart(2, '0')}</span>
      <span class="hs-bar"><span class="hs-bar-fill" id="hsBar"></span></span>
    </div>
  </div>
</section>


